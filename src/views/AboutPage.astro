---
import { alt } from '../data/photos';
import Base from '../layouts/Base.astro';
import { img, waLink } from '../data/site';
import { ui, altEn, type Lang } from '../i18n';

// About me, in Hebrew (/about/) or English (/en/about/).
interface Props { lang?: Lang }
const { lang = 'he' } = Astro.props;
const en = lang === 'en';
const t = ui[lang];

const stepsHe = [
  { title: 'קולומביה אותנטית', text: 'המקומות, האנשים והטעמים שאני חי כאן כל יום, לא מה שמופיע בכל מדריך.' },
  { title: 'הכל דרכי', text: 'אני בונה איתכם את הטיול, בוחר מי ילווה אתכם ונשאר זמין לאורך כל הדרך.' },
  { title: 'מחירים הוגנים', text: 'מחירים של מקומי, בלי תיווך של סוכנות.' },
];
// Real reviews only (confirmed by Jonathan). Add new ones to this list.
const reviewsHe = [
  { text: 'הגענו לקולומביה עם הרבה אי וודאות, דיברנו עם יונתן והכל היה כל כך קל. הוא סידר לנו טיול לגואטפה, שטנו באגם ואכלנו במקום מקומי שלא היינו מוצאים לבד. הרגשנו כמו עם חבר שגר פה.', who: 'מיכל, 23 · טיול לגואטפה', stars: 5 },
  { text: 'רצינו יום שייתן לנו להכיר את קולומביה מעבר למקומות הרגילים, וזה בדיוק מה שקיבלנו. אוכל מקומי, נופים וסיפורים קטנים שעזרו לנו להבין את החיים פה. יונתן היה קשוב לקצב שלנו ויצר אווירה ממש נעימה. חזרנו עם תחושה שהכרנו עוד צד של קולומביה.', who: 'מאור, 22', stars: 5 },
  { text: 'בעלי ואני הגענו ליונתן עם רשימה ארוכה של מקומות שרצינו לראות ובלי מושג איך לחבר ביניהם. הוא עזר לנו לבנות מסלול שמתאים לזמן, לתקציב ולסגנון שלנו, וגם אמר בכנות על מה כדאי לוותר. במהלך הטיול הבנו כמה התכנון הזה עזר — המעברים היו הגיוניים, היה זמן לנוח ולא הרגשנו שאנחנו כל היום עם המזוודות. חסך לנו המון התלבטויות.', who: 'אלה, 38 · תכנון מסלול', stars: 5 },
  { text: 'אני וכמה חברים סגרנו עם יונתן יום של רכיבה על סוסים ופיינטבול והיה פשוט כיף! התחלנו ברכיבה מול נופים מדהימים, ואחר כך פיינטבול. יונתן דאג לארגון ולאווירה, ואנחנו רק היינו צריכים להגיע וליהנות. יום מלא צחוקים וחוויות שאנחנו עדיין מדברים עליו!', who: 'שלומית, 24 · סוסים ופיינטבול', stars: 5 },
];
// The same real reviews, translated from Hebrew for the English site.
const reviewsEn = [
  { text: 'We came to Colombia with a lot of uncertainty, talked to Yonatan, and everything was so easy. He set up a Guatapé trip for us, we sailed on the lake and ate at a local place we’d never have found on our own. It felt like being with a friend who lives here.', who: 'Michal, 23 · Guatapé tour', stars: 5 },
  { text: 'We wanted a day that would let us get to know Colombia beyond the usual places, and that’s exactly what we got. Local food, views and little stories that helped us understand life here. Yonatan paid attention to our pace and created a really pleasant atmosphere. We came back feeling we’d seen another side of Colombia.', who: 'Maor, 22', stars: 5 },
  { text: 'My husband and I came to Yonatan with a long list of places we wanted to see and no idea how to connect them. He helped us build a route that fit our time, budget and style, and honestly told us what was worth skipping. During the trip we realized how much that planning helped: the transfers made sense, there was time to rest, and we didn’t feel like we were living out of our suitcases. It saved us so much back and forth.', who: 'Ella, 38 · Trip planning', stars: 5 },
  { text: 'A few friends and I booked a day of horseback riding and paintball with Yonatan, and it was just so much fun! We started with riding in front of amazing views, then paintball. Yonatan took care of the planning and the vibe, and all we had to do was show up and enjoy. A day full of laughs that we still talk about!', who: 'Shlomit, 24 · Horses & paintball', stars: 5 },
];
const stepsEn = [
  { title: 'Authentic Colombia', text: 'The places, people and flavors I live with here every day, not what’s in every guidebook.' },
  { title: 'Everything goes through me', text: 'I build the trip with you, choose who will be with you, and stay available all the way.' },
  { title: 'Fair prices', text: 'Local prices, with no agency in the middle.' },
];
const steps = en ? stepsEn : stepsHe;
const reviews = en ? reviewsEn : reviewsHe;
const L = en
  ? {
      title: 'Your Personal Contact in Colombia: Yonatan in Medellín',
      desc: 'Hi, I’m Yonatan Milman, and I live in Medellín. I show you authentic Colombia the way locals live it, take care of every detail and stay available throughout your trip.',
      pill: 'About me', h1a: 'Hi, I’m Yonatan.', h1b: 'I live in Medellín.',
      p1: 'Colombia is my home. I want you to experience it the way I live it: local, real, with the people and places I know. And I’m available to you all the way.',
      p2: 'Whether you’re backpackers, on a bachelor party, or retirees out for an adventure, I’ll plan a great experience that fits you exactly.',
      talk: 'Message me on WhatsApp', meAlt: 'Yonatan Milman on a horse in the hills of Antioquia', how: 'How I work',
      say: 'What travelers say', note: 'Reviews translated from Hebrew', rating: (n: number) => `Rated ${n} out of 5 stars`, prev: 'Previous review', next: 'Next review',
    }
  : null;
---
<Base lang={lang} title={L?.title ?? "מדריך אישי בקולומביה: יונתן, ישראלי במדג'ין"} description={L?.desc ?? "היי, אני יונתן מילמן, ישראלי שגר במדג'ין. אני מראה לכם את קולומביה האותנטית, כמו שהמקומיים חיים אותה, דואג לכל הפרטים וזמין לכם לאורך כל הטיול."} image={img('israeli-guide-medellin-yonatan')} nav="about">
  <section class="page-top">
    <div class="wrap a-hero">
      <div style="display:flex;flex-direction:column;gap:18px">
        <span class="pill" style="align-self:flex-start">{L?.pill ?? 'מי אני'}</span>
        <h1 style="font-size:clamp(40px,6vw,56px);line-height:1.1;font-weight:800">{L?.h1a ?? 'היי, אני יונתן.'}<br />{L?.h1b ?? "ישראלי שגר במדג'ין."}</h1>
        <p style="font-size:20px;line-height:1.7;max-width:560px">{L?.p1 ?? 'קולומביה היא הבית שלי. אני רוצה שתחוו אותה כמו שאני חי אותה: מקומית, אמיתית, עם האנשים והמקומות שאני מכיר. ואני זמין לכם לאורך כל הדרך.'}</p>
        <p style="font-size:18px;line-height:1.7;max-width:560px">{L?.p2 ?? "גם אם אתם מוצ'ילרים אחרי צבא, במסיבת רווקים או פנסיונרים שיוצאים לחוות, אני אתכנן בשבילכם חוויה נעימה שמתאימה בדיוק לכם."}</p>
        <a href={waLink(t.waDefault)} class="btn btn-yellow" style="align-self:flex-start" target="_blank" rel="noopener">{L?.talk ?? 'דברו איתי בוואטסאפ'}</a>
      </div>
      <div class="mosaic">
        <img src={img('israeli-guide-medellin-yonatan')} alt={L?.meAlt ?? 'יונתן מילמן רוכב על סוס בהרי אנטיוקיה'} sizes="(max-width: 900px) 100vw, 40vw" style="grid-row:span 2;object-position:40% 50%" />
        <img src={img('medellin-for-travelers-aburra-valley')} alt={en ? altEn('medellin-for-travelers-aburra-valley') : alt('medellin-for-travelers-aburra-valley')} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" />
        <img src={img('private-tour-medellin-fishing')} alt={en ? altEn('private-tour-medellin-fishing') : alt('private-tour-medellin-fishing')} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">{L?.how ?? 'איך אני עובד'}</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px">
      {steps.map((s, i) => (
        <div style="border:1px solid var(--line);border-radius:var(--radius);padding:24px;display:flex;flex-direction:column;gap:10px;box-shadow:var(--shadow)">
          <span class="deco-num" aria-hidden="true" data-n={`0${i + 1}`} style="font-size:44px"></span>
          <strong style="font-size:21px">{s.title}</strong>
          <span style="font-size:17px;line-height:1.6;color:var(--text)">{s.text}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-cream" data-reviews>
    <div class="wrap section" style="max-width:900px;text-align:center;display:flex;flex-direction:column;gap:24px;align-items:center">
      <h2 style="font-size:34px">{L?.say ?? 'מה מטיילים אומרים'}</h2>
      <div class="rv-track" aria-live="polite">
        {reviews.map((r, i) => (
          <figure class:list={['rv', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
            <div class="stars" role="img" aria-label={L ? L.rating(r.stars) : `דירוג ${r.stars} מתוך 5 כוכבים`}>{'★'.repeat(r.stars)}</div>
            <blockquote>“{r.text}”</blockquote>
            <figcaption>{r.who}</figcaption>
          </figure>
        ))}
      </div>
      {reviews.length > 1 && <div style="display:flex;gap:10px;align-items:center">
        <button type="button" class="rv-btn" aria-label={L?.prev ?? 'ההמלצה הקודמת'} data-rv-prev>{en ? '‹' : '›'}</button>
        {reviews.map((_, i) => <span aria-hidden="true" class:list={['rv-dot', { 'is-active': i === 0 }]}></span>)}
        <button type="button" class="rv-btn" aria-label={L?.next ?? 'ההמלצה הבאה'} data-rv-next>{en ? '›' : '‹'}</button>
      </div>}
      {en && <p style="margin:0;font-size:14px;color:var(--muted)">{L!.note}</p>}
    </div>
  </section>

  <section class="wrap section photo-grid">
    <img src={img('jardin-horseback-riding')} alt={en ? altEn('jardin-horseback-riding') : alt('jardin-horseback-riding')} sizes="(max-width: 900px) 100vw, 60vw" loading="lazy" style="grid-column:span 2;grid-row:span 2" />
    <img src={img('jardin-cave-waterfall')} alt={en ? altEn('jardin-cave-waterfall') : alt('jardin-cave-waterfall')} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" />
    <img src={img('medellin-restaurants-watermelon')} alt={en ? altEn('medellin-restaurants-watermelon') : alt('medellin-restaurants-watermelon')} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" style="grid-row:span 2" />
    <img src={img('guatape-day-trip-umbrella-street')} alt={en ? altEn('guatape-day-trip-umbrella-street') : alt('guatape-day-trip-umbrella-street')} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" />
  </section>
</Base>

<style>
  .a-hero { padding-top: 64px; padding-bottom: 64px; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 48px; align-items: center; }
  .mosaic { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 200px 200px; gap: 12px; }
  .mosaic img { width: 100%; height: 100%; object-fit: cover; border-radius: 22px; border: 5px solid #fff; box-shadow: 0 6px 18px rgba(20, 27, 45, 0.12); }
  .rv-track { display: grid; width: 100%; overflow: hidden; }
  .rv { grid-area: 1 / 1; margin: 0; opacity: 0; transform: translateX(-20px); transition: opacity 500ms ease, transform 500ms ease; }
  .rv.is-active { opacity: 1; transform: none; }
  .rv blockquote { margin: 0; font-size: 21px; line-height: 1.6; font-weight: 500; }
  .stars { color: var(--yellow); -webkit-text-stroke: 1px var(--ink); font-size: 24px; letter-spacing: 4px; margin-bottom: 10px; }
  .rv figcaption { margin-top: 12px; color: var(--text); }
  .rv-btn { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line-strong); background: #fff; cursor: pointer; font-size: 20px; }
  .rv-dot { height: 8px; width: 8px; border-radius: 999px; background: var(--line-strong); transition: all 300ms ease; }
  .rv-dot.is-active { width: 24px; background: var(--blue); }
  .photo-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 200px; gap: 12px; }
  .photo-grid img { width: 100%; height: 100%; object-fit: cover; border-radius: 18px; border: 5px solid #fff; box-shadow: 0 6px 18px rgba(20, 27, 45, 0.12); }
  @media (max-width: 900px) {
    .a-hero { grid-template-columns: minmax(0, 1fr); }
    .photo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 160px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-reviews]');
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>('.rv')];
    const dots = [...root.querySelectorAll<HTMLElement>('.rv-dot')];
    let i = 0;
    const show = (n: number) => {
      i = (n + items.length) % items.length;
      items.forEach((x, k) => { x.classList.toggle('is-active', k === i); x.setAttribute('aria-hidden', String(k !== i)); });
      dots.forEach((d, k) => d.classList.toggle('is-active', k === i));
    };
    root.querySelector('[data-rv-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-rv-next]')?.addEventListener('click', () => show(i + 1));
  }
</script>
