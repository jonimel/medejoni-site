---
import Base from '../layouts/Base.astro';
import TourCard from '../components/TourCard.astro';
import Icon from '../components/Icon.astro';
import { tours as toursHe, kindLabel as kindLabelHe, fromPrice } from '../data/tours';
import { toursEn, kindLabelEn } from '../data/tours.en';
import { destNamesEn } from '../data/services.en';
import { destinations } from '../data/destinations';
import { ui, lp, type Lang } from '../i18n';

// The tours list with filters, in Hebrew (/tours/) or English (/en/tours/).
interface Props { lang?: Lang }
const { lang = 'he' } = Astro.props;
const en = lang === 'en';
const t = ui[lang];
const tours = en ? toursEn : toursHe;
const kindLabel = en ? kindLabelEn : kindLabelHe;
const destName = (d: { slug: string; name: string }) => (en ? destNamesEn[d.slug] ?? d.name : d.name);
const L = en
  ? {
      title: 'Colombia Tours: Day Trips from Medellín & Tayrona',
      desc: 'All tours and activities: Medellín, Guatapé, Jardín, the Antioquia countryside and Tayrona Park. Private tours, group tours and evening experiences, with per-person prices in COP.',
      crumb: 'Tours', h1: 'All tours in Colombia', sub: 'Private, group and evening experiences. All prices are per person.',
      filters: 'Filters', search: 'Search', searchPh: 'Search tours', dest: 'Destination', kind: 'Tour type', priceUpTo: 'Max price:',
      reset: 'Clear filters', count: 'tours', sort: 'Sort', rec: 'Recommended', low: 'Price: low to high', high: 'Price: high to low',
      list: 'Tour list', empty: 'No tours match these filters.',
      kindH: 'Group or private?', kindSub: 'Travel on your own, or join an existing group, whatever kind of traveler you are!',
      groupH: 'Group tours', group: ['Depart every day at set times', 'I handle the registration and save your spots, and I’m available for any question', 'Book at least 36 hours ahead'],
      privH: 'Private tours', priv: ['Built around you: route, driver and a local guide, and I’m available on WhatsApp all day', 'The price per person drops as your group grows', 'Best booked at least 48 hours ahead'],
      faqH: 'FAQ', itemList: 'Tours in Colombia',
    }
  : null;

const activeDests = destinations.filter((d) => !d.comingSoon && tours.some((t) => t.destination === d.slug));
const maxPrice = Math.max(...tours.map(fromPrice));
const faqHe = [
  { q: 'כל המחירים לאדם?', a: 'כן. כל המחירים באתר הם לאדם, בפסו קולומביאני (COP).' },
  { q: 'יש איסוף מהמלון?', a: 'בכל הטיולים יש איסוף מהמלון, חוץ מהטיול הקבוצתי לגואטפה שיוצא מפארק אל פובלדו.' },
  { q: 'עד מתי אפשר לבטל?', a: 'אפשר לבטל עד 12 שעות לפני תחילת הטיול.' },
  { q: 'כמה זמן מראש צריך להזמין?', a: 'טיול קבוצתי: לפחות 36 שעות מראש. טיול פרטי: מומלץ לפחות 48 שעות מראש.' },
  { q: 'אפשר להוסיף אטרקציות?', a: 'בחלק מהטיולים אפשר להוסיף אטרקציות בתוספת תשלום. הן מופיעות בדף של כל טיול.' },
];
const faqEn = [
  { q: 'Are all prices per person?', a: 'Yes. All prices on the site are per person, in Colombian pesos (COP).' },
  { q: 'Is there hotel pickup?', a: 'All tours include hotel pickup, except the Guatapé group tour, which leaves from Parque El Poblado.' },
  { q: 'How late can I cancel?', a: 'You can cancel up to 12 hours before the tour starts.' },
  { q: 'How far ahead should I book?', a: 'Group tours: at least 36 hours ahead. Private tours: we recommend at least 48 hours ahead.' },
  { q: 'Can I add activities?', a: 'On some tours you can add activities for an extra fee. They’re listed on each tour’s page.' },
];
const faq = en ? faqEn : faqHe;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: L?.itemList ?? 'טיולים בקולומביה',
  itemListElement: tours.map((x, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(lp(lang, `/tours/${x.slug}/`), Astro.site).toString(), name: x.title })),
};
---
<Base lang={lang} title={L?.title ?? "סיורים בקולומביה: טיולי יום ממדג'ין וטאירונה"} description={L?.desc ?? "כל הטיולים והאטרקציות: מדג'ין, גואטפה, חרדין, כפרי אנטיוקיה ופארק טאירונה. טיולים פרטיים, קבוצתיים וחוויות ערב, עם מחירים לאדם ב־COP."} nav="tours" jsonLd={[ld, itemList]}>
  <section class="page-top">
    <div class="wrap" style="padding-top:40px;padding-bottom:40px">
      <nav class="crumbs" aria-label={t.crumbs} style="padding-top:0;color:var(--ink)"><a href={lp(lang, '/')} style="color:var(--ink)">{t.nav.home}</a> › {L?.crumb ?? 'טיולים'}</nav>
      <h1 style="font-size:clamp(34px,5vw,52px);font-weight:800">{L?.h1 ?? 'כל הטיולים בקולומביה'}</h1>
      <p style="font-size:19px;margin-top:10px">{L?.sub ?? 'פרטיים, קבוצתיים וחוויות ערב. כל המחירים לאדם.'}</p>
    </div>
  </section>

  <div class="wrap tours-layout" style="padding-top:32px;padding-bottom:72px" data-tours>
    <aside class="filters" aria-label={L?.filters ?? 'סינון'}>
      <div class="filter-box">
        <label class="search-mini">
          <Icon name="search" />
          <span class="sr-only">{L?.search ?? 'חיפוש'}</span>
          <input type="search" placeholder={L?.searchPh ?? 'חיפוש טיול'} data-q />
        </label>
      </div>
      <fieldset class="filter-box">
        <legend>{L?.dest ?? 'יעד'}</legend>
        {activeDests.map((d) => (
          <label class="check"><input type="checkbox" value={d.slug} data-dest /> {destName(d)}</label>
        ))}
      </fieldset>
      <fieldset class="filter-box">
        <legend>{L?.kind ?? 'סוג טיול'}</legend>
        {Object.entries(kindLabel).map(([k, v]) => (
          <label class="check"><input type="checkbox" value={k} data-kind /> {v}</label>
        ))}
      </fieldset>
      <div class="filter-box">
        <label for="price" style="font-weight:700;display:block;margin-bottom:8px">{L?.priceUpTo ?? 'מחיר עד:'} <span class="ltr" data-price-out>{maxPrice.toLocaleString('en-US')}</span> COP</label>
        <input id="price" type="range" min="100000" max={maxPrice} step="10000" value={maxPrice} data-price style="width:100%;accent-color:var(--blue)" />
      </div>
      <button type="button" class="btn btn-outline btn-block" data-reset>{L?.reset ?? 'ניקוי סינון'}</button>
    </aside>

    <div>
      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px">
        <span style="font-size:17px" aria-live="polite"><strong data-count>{tours.length}</strong> {L?.count ?? 'טיולים'}</span>
        <label style="display:flex;align-items:center;gap:8px;font-size:15px">{L?.sort ?? 'מיון'}
          <select data-sort style="min-height:44px;border:1px solid var(--line-strong);border-radius:10px;padding:0 12px;font:inherit;background:#fff">
            <option value="rec">{L?.rec ?? 'מומלצים'}</option>
            <option value="low">{L?.low ?? 'מחיר: מהנמוך לגבוה'}</option>
            <option value="high">{L?.high ?? 'מחיר: מהגבוה לנמוך'}</option>
          </select>
        </label>
      </div>
      <h2 class="sr-only">{L?.list ?? 'רשימת הטיולים'}</h2>
      <div class="tour-grid" data-grid>
        {tours.map((x) => <TourCard tour={x} lang={lang} />)}
      </div>
      <p data-empty hidden style="text-align:center;padding:48px 0;font-size:18px;color:var(--muted)">{L?.empty ?? 'לא מצאנו טיול שמתאים לסינון.'} <a href="#" data-reset>{L?.reset ?? 'ניקוי סינון'}</a></p>
    </div>
  </div>

  <section class="bg-cream">
    <div class="wrap section">
      <h2 class="section-title" style="margin-bottom:8px">{L?.kindH ?? 'קבוצתי או פרטי?'}</h2>
      <p style="margin:0 0 24px;text-align:center;font-size:18px;color:var(--text)">{L?.kindSub ?? 'אפשר לטייל לבד, או להצטרף לקבוצה קיימת – בהתאם לסוג המטיילים שאתם!'}</p>
      <div class="kind-grid">
        <div class="kind-card">
          <h3>{L?.groupH ?? 'טיולים קבוצתיים'}</h3>
          {L ? <ul>{L.group.map((x) => <li>{x}</li>)}</ul> : <ul>
            <li>יוצאים כל יום בשעות קבועות</li>
            <li>אני דואג לרישום ולשריון המקומות, ונשאר זמין לכל שאלה</li>
            <li>מזמינים לפחות 36 שעות מראש</li>
          </ul>}
        </div>
        <div class="kind-card">
          <h3>{L?.privH ?? 'טיולים פרטיים'}</h3>
          {L ? <ul>{L.priv.map((x) => <li>{x}</li>)}</ul> : <ul>
            <li>מותאמים אליכם: מסלול, נהג ומדריך מקומי, ואני זמין לכם בוואטסאפ לאורך כל היום</li>
            <li>המחיר לאדם יורד ככל שאתם יותר</li>
            <li>מומלץ להזמין לפחות 48 שעות מראש</li>
          </ul>}
        </div>
      </div>
    </div>
  </section>

  <section id="faq">
    <div class="wrap section" style="max-width:860px">
      <h2 class="section-title">{L?.faqH ?? 'שאלות נפוצות'}</h2>
      <div class="faq">
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .kind-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .kind-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 24px; }
  .kind-card h3 { font-size: 22px; margin-bottom: 10px; }
  .kind-card ul { margin: 0; padding-inline-start: 20px; font-size: 17px; line-height: 1.8; color: var(--text); }
  @media (max-width: 560px) { .kind-grid { grid-template-columns: minmax(0, 1fr); } }
  .tours-layout { display: grid; grid-template-columns: 280px 1fr; gap: 32px; align-items: start; }
  .filters { position: sticky; top: 90px; display: flex; flex-direction: column; gap: 14px; }
  .filter-box { border: 1px solid var(--line); border-radius: 14px; padding: 16px; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .filter-box legend { font-weight: 700; padding: 0 4px; }
  .check { display: flex; align-items: center; gap: 10px; min-height: 44px; font-size: 16px; cursor: pointer; }
  .check input { width: 18px; height: 18px; accent-color: var(--blue); }
  .search-mini { display: flex; align-items: center; gap: 8px; color: var(--muted); }
  .search-mini input { border: 0; outline: none; font: inherit; font-size: 16px; min-height: 40px; flex: 1; min-width: 0; color: var(--ink); }
  @media (max-width: 900px) {
    .tours-layout { grid-template-columns: 1fr; }
    .filters { position: static; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-tours]')!;
  const grid = root.querySelector<HTMLElement>('[data-grid]')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.tour-card')];
  const q = root.querySelector<HTMLInputElement>('[data-q]')!;
  const dests = [...root.querySelectorAll<HTMLInputElement>('[data-dest]')];
  const kinds = [...root.querySelectorAll<HTMLInputElement>('[data-kind]')];
  const price = root.querySelector<HTMLInputElement>('[data-price]')!;
  const priceOut = root.querySelector<HTMLElement>('[data-price-out]')!;
  const sort = root.querySelector<HTMLSelectElement>('[data-sort]')!;
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;

  const params = new URLSearchParams(location.search);
  if (params.get('q')) q.value = params.get('q')!;
  if (params.get('dest')) dests.forEach((d) => (d.checked = d.value === params.get('dest')));

  function apply() {
    const term = q.value.trim().replace(/['׳"]/g, '');
    const ds = dests.filter((d) => d.checked).map((d) => d.value);
    const ks = kinds.filter((k) => k.checked).map((k) => k.value);
    const max = Number(price.value);
    priceOut.textContent = max.toLocaleString('en-US');
    let n = 0;
    cards.forEach((c) => {
      const text = (c.textContent ?? '').replace(/['׳"]/g, '');
      const ok = (!term || text.includes(term))
        && (!ds.length || ds.includes(c.dataset.dest!))
        && (!ks.length || ks.includes(c.dataset.kind!))
        && Number(c.dataset.price) <= max;
      c.hidden = !ok;
      if (ok) n++;
    });
    count.textContent = String(n);
    empty.hidden = n > 0;
    const sorted = [...cards];
    if (sort.value === 'low') sorted.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
    if (sort.value === 'high') sorted.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
    sorted.forEach((c) => grid.appendChild(c));
  }
  [q, price, sort, ...dests, ...kinds].forEach((el) => el.addEventListener('input', apply));
  root.ownerDocument.querySelectorAll('[data-reset]').forEach((b) => b.addEventListener('click', (e) => {
    e.preventDefault();
    q.value = '';
    [...dests, ...kinds].forEach((x) => (x.checked = false));
    price.value = price.max;
    sort.value = 'rec';
    apply();
  }));
  apply();
</script>
