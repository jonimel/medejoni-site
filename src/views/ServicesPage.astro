---
import { alt } from '../data/photos';
import Base from '../layouts/Base.astro';
import ServiceForm from '../components/ServiceForm.astro';
import Icon from '../components/Icon.astro';
import { services as servicesHe } from '../data/services';
import { servicesEn } from '../data/services.en';
import { img, thumb } from '../data/site';
import { ui, lp, type Lang } from '../i18n';

// Transfers, flights and trip planning, in Hebrew (/services/) or English (/en/services/).
interface Props { lang?: Lang }
const { lang = 'he' } = Astro.props;
const en = lang === 'en';
const t = ui[lang];
const services = en ? servicesEn : servicesHe;
const L = en
  ? {
      title: 'Airport Transfers, Private Transfers & Flights in Colombia',
      desc: 'Airport-to-hotel transfers in Medellín, Cartagena and Bogotá, private city-to-city transfers, and domestic and international flight booking, arranged personally with Yonatan Milman.',
      crumb: 'Transfers & flights', h1: 'Transfers, flights and trip planning in Colombia',
      sub: 'From landing to your next flight, I’ve got you covered. Fill in a short form and get a quote from me.',
      routes: 'Popular routes', book: 'Book →',
    }
  : null;

const ld = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.intro,
  areaServed: 'Colombia',
  provider: { '@type': 'TravelAgency', name: 'Medejoni' },
}));
---
<Base lang={lang} title={L?.title ?? 'הסעות משדה התעופה, מעברים וטיסות בקולומביה'} description={L?.desc ?? "הסעה משדה התעופה למלון במדג'ין, בקרטחנה ובבוגוטה, מעברים פרטיים בין ערים, וסגירת טיסות פנים ולחו״ל, בתיאום אישי עם יונתן מילמן."} image={img('medellin-for-travelers-aburra-valley')} nav="services" jsonLd={ld}>
  <section class="page-top">
    <div class="wrap" style="padding-top:40px;padding-bottom:40px">
      <nav class="crumbs" aria-label={t.crumbs} style="padding-top:0;color:var(--ink)"><a href={lp(lang, '/')} style="color:var(--ink)">{t.nav.home}</a> › {L?.crumb ?? 'הסעות וטיסות'}</nav>
      <h1 style="font-size:clamp(34px,5vw,52px);font-weight:800">{L?.h1 ?? 'הסעות, טיסות ותכנון טיולים בקולומביה'}</h1>
      <p style="font-size:19px;margin-top:10px">{L?.sub ?? 'מהנחיתה ועד הטיסה הבאה, אני דואג לכם. ממלאים טופס קצר ומקבלים ממני הצעת מחיר.'}</p>
      <div class="chips" style="justify-content:flex-start;margin:20px 0 0">
        {services.map((s) => <a href={`#${s.id}`} class="chip">{s.title}</a>)}
      </div>
    </div>
  </section>

  {services.map((s, i) => (
    <section id={s.id} class:list={['svc', { 'bg-cream': i % 2 }]}>
      <div class="wrap section svc-grid">
        <div class="svc-text">
          <span class="ico-circle" aria-hidden="true"><Icon name={s.icon} size={24} /></span>
          <h2 style="font-size:clamp(28px,4vw,36px)">{s.title}</h2>
          <p style="font-size:18px;line-height:1.7;color:var(--text)">{s.intro}</p>
          <ul class="svc-points">{s.points.map((p) => <li>{p}</li>)}</ul>
          {s.routes && (
            <div class="routes">
              <strong>{L?.routes ?? 'מסלולים פופולריים'}</strong>
              {s.routes.map((r) => (
                <button type="button" class="route card" data-route-from={r.from} data-route-to={r.to} data-form={s.id}>
                  <img src={thumb(r.image)} alt="" loading="lazy" />
                  <span><strong>{en ? `${r.from} → ${r.to}` : `${r.from} ← ${r.to}`}</strong><small>{r.note}</small><em>{L?.book ?? 'להזמנה ←'}</em></span>
                </button>
              ))}
            </div>
          )}
          <img src={img(s.image)} alt={en ? s.title : alt(s.image)} loading={i === 0 ? 'eager' : 'lazy'} sizes="(max-width: 900px) 100vw, 50vw" />
        </div>
        <ServiceForm id={s.id} title={s.formTitle} fields={s.fields} lang={lang} />
      </div>
    </section>
  ))}
</Base>

<style>
  .svc { scroll-margin-top: calc(var(--header-h) + 16px); }
  .svc-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .svc-text { display: flex; flex-direction: column; gap: 16px; }
  .svc-text img { width: 100%; height: 240px; object-fit: cover; border-radius: 20px; margin-top: 8px; }
  .svc-points { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; font-size: 17px; }
  .svc-points li { display: flex; gap: 10px; align-items: center; }
  .svc-points li::before { content: '✓'; flex: 0 0 24px; height: 24px; border-radius: 50%; background: var(--cream); color: var(--blue); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; }
  .routes { display: flex; flex-direction: column; gap: 10px; }
  .route { display: flex; gap: 14px; align-items: center; text-align: start; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 10px; cursor: pointer; font: inherit; color: inherit; }
  .route img { width: 96px; height: 96px; object-fit: cover; border-radius: 12px; flex: 0 0 auto; margin: 0; }
  .route span { display: flex; flex-direction: column; gap: 4px; }
  .route strong { font-size: 18px; }
  .route small { color: var(--muted); font-size: 15px; }
  .route em { font-style: normal; color: var(--link); font-weight: 600; }
  @media (max-width: 900px) {
    .svc-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .svc-text img { height: 200px; }
  }
</style>

<script>
  // Popular route buttons prefill the transfer form.
  document.querySelectorAll<HTMLButtonElement>('[data-route-from]').forEach((b) => b.addEventListener('click', () => {
    const form = document.querySelector<HTMLFormElement>(`form[name="${b.dataset.form}"]`)!;
    (form.elements.namedItem('from') as HTMLInputElement).value = b.dataset.routeFrom!;
    (form.elements.namedItem('to') as HTMLInputElement).value = b.dataset.routeTo!;
    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    form.querySelector<HTMLInputElement>('[name=name]')!.focus({ preventScroll: true });
  }));
</script>

