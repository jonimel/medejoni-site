---
import { alt } from '../data/photos';
import Base from '../layouts/Base.astro';
import TourCard from '../components/TourCard.astro';
import Carousel from '../components/Carousel.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import { tours } from '../data/tours';
import { destinations } from '../data/destinations';
import { guides } from '../data/guides';
import { services } from '../data/services';
import { img, thumb, waLink, site } from '../data/site';
import { toursEn } from '../data/tours.en';
import { servicesEn, destNamesEn } from '../data/services.en';
import { ui, lp, altEn, type Lang } from '../i18n';

// The home page, in Hebrew (/) or English (/en/).
interface Props { lang?: Lang }
const { lang = 'he' } = Astro.props;
const en = lang === 'en';
const t = ui[lang];
const tourList = en ? toursEn : tours;
const serviceList = en ? servicesEn : services;

const slidesHe = [
  { kicker: 'קולומביה, כמו שהמקומיים חיים אותה', title: 'קולומביה אותנטית, עם יונתן', sub: "לא עוד טיול של תיירים. המקומות, האנשים והטעמים שאני חי כאן כל יום", img: 'guatape-colombia-el-penol' },
  { kicker: "מדג'ין בלילה", title: 'העיר נדלקת בערב', sub: 'סיור מצפים, צ׳יבה רומברה, ואורות העמק מלמעלה', img: 'medellin-nightlife-city-lights' },
  { kicker: 'חוויה של פעם בחיים', title: 'משחק של אתלטיקו נסיונל', sub: 'כרטיס, הסעה, מדריך, והבירה הראשונה עלינו', img: 'atletico-nacional-fans-medellin' },
];
const slidesEn = [
  { kicker: 'Colombia, the way locals live it', title: 'Authentic Colombia, with Yonatan', sub: 'Not another tourist trip. The places, people and flavors I live with here every day', img: 'guatape-colombia-el-penol' },
  { kicker: 'Medellín by night', title: 'The city lights up at night', sub: 'Viewpoints tour, Chiva Rumbera, and the valley lights from above', img: 'medellin-nightlife-city-lights' },
  { kicker: 'A once-in-a-lifetime experience', title: 'An Atlético Nacional match', sub: 'Ticket, transport, guide, and your first beer on us', img: 'atletico-nacional-fans-medellin' },
];
const slides = en ? slidesEn : slidesHe;
const whyHe = [
  { icon: 'heart', title: 'ליווי אישי וזמינות', text: "גר במדג'ין, קולומביה, וזמין לתת שירות לאורך כל הדרך." },
  { icon: 'wallet', title: 'מחירים מקומיים – לכל כיס', text: 'מחירים של מקומי, בלי תיווך של סוכנות. בטיולים פרטיים המחיר לאדם יורד ככל שאתם יותר.' },
  { icon: 'star', title: 'אותנטיות', text: 'חוויות מקומיות ואותנטיות, לא מה שכולם עושים.' },
  { icon: 'award', title: 'ניסיון', text: 'מעל שנתיים של ניסיון והיכרות עם העיר.' },
] as const;
const whyEn = [
  { icon: 'heart', title: 'Personal support', text: 'I live in Medellín, Colombia, and I’m available to help you all the way.' },
  { icon: 'wallet', title: 'Local prices for every budget', text: 'Local prices with no agency markup. On private tours, the price per person drops as your group grows.' },
  { icon: 'star', title: 'Authentic', text: 'Local, authentic experiences, not what everyone else does.' },
  { icon: 'award', title: 'Experience', text: 'More than two years of experience and knowing the city.' },
] as const;
const why = en ? whyEn : whyHe;
const countFor = (slug: string) => {
  const n = tourList.filter((x) => x.destination === slug).length;
  if (en) return n === 0 ? 'Coming soon' : n === 1 ? '1 tour' : `${n} tours`;
  return n === 0 ? 'בקרוב' : n === 1 ? 'טיול אחד' : `${n} טיולים`;
};
const cats = en
  ? [
      ['all', 'All'],
      ['private', 'Private tours'],
      ['group', 'Group tours'],
      ['couples', 'For couples'],
      ['evening', 'Evening experiences'],
    ]
  : [
      ['all', 'הכל'],
      ['private', 'טיולים פרטיים'],
      ['group', 'טיולים קבוצתיים'],
      ['couples', 'טיולים לזוגות'],
      ['evening', 'חוויות ערב'],
    ];
const L = en
  ? {
      title: 'Medellín Tours & Day Trips in Colombia',
      desc: 'Authentic Colombia with Yonatan Milman, who lives in Medellín: Guatapé day trip, Comuna 13 and Pablo Escobar tours, Jardín, Tayrona Park and airport transfers. Hotel pickup.',
      imageAlt: 'El Peñol Rock and the lake in Guatapé, Colombia', slider: 'Main slider', h1: 'Tours & day trips in Colombia, with Yonatan',
      search: 'Search tours', searchPh: 'Guatapé, Escobar, viewpoints...', searchBtn: 'Search', slide: (i: number, n: number) => `Slide ${i} of ${n}`,
      pause: 'Pause the slider', play: 'Play the slider', toursH: 'Tours & day trips from Medellín', filter: 'Filter by tour type',
      couples: 'Time for two, with no rush and no group: views, sunsets, clear beaches and experiences built around you. I set the pace for you and take care of everything else.',
      allTours: 'All tours', destH: 'Destinations in Colombia', destLabel: 'Destinations', comingSoon: 'Coming soon', whyH: 'Why travel with me?',
      svcNav: 'Transfers, flights and trip planning', meAlt: 'Yonatan Milman on a horse in the hills of Antioquia', hi: 'Hi, I’m Yonatan Milman',
      meText: 'I’ve lived in Medellín for two years, and Colombia is my second home. Every trip goes through me: I build it with you and choose the people who will be with you.',
      talk: 'Message me on WhatsApp', more: 'More about me', moments: 'Moments from the field', momentsAria: 'More moments on Instagram',
    }
  : null;
// "Moments" strip: 4 still photos linking to Instagram (no moving strip).
const moments = ['guatape-wakeboard-el-penol', 'chiva-rumbera-party-bus', 'jardin-cave-waterfall', 'antioquia-farm-cow'];
// Article cards on the home page use a photo that is not already shown in the destinations row above.
const homeGuides = guides.slice(0, 2).map((g, i) => ({ ...g, card: ['coffee-valley-colombia-cocora', 'tayrona-park-beach-rocks'][i] ?? g.image }));
---
<Base
  lang={lang}
  title={L?.title ?? "סיורים וטיולים בקולומביה עם ישראלי ממדג'ין"}
  description={L?.desc ?? "קולומביה אותנטית עם יונתן מילמן, ישראלי שגר במדג'ין: טיול לגואטפה, סיור קומונה 13 ואסקובר, חרדין, פארק טאירונה והסעות משדה התעופה. איסוף מהמלון."}
  imageAlt={L?.imageAlt ?? 'סלע אל פניול והאגם בגואטפה, קולומביה'}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL(en ? '/en/#website' : '/#website', Astro.site).toString(),
    name: 'Medejoni',
    alternateName: 'מדג׳וני',
    url: new URL(lp(lang, '/'), Astro.site).toString(),
    inLanguage: lang,
    publisher: { '@id': new URL('/#org', Astro.site).toString() },
  }}
>
  <section class="hero" aria-label={L?.slider ?? 'סליידר ראשי'} data-hero>
    {slides.map((s, i) => (
      <div class:list={['hero-slide', { 'is-active': i === 0 }]} data-kicker={s.kicker} data-title={s.title} data-sub={s.sub}>
        <img src={img(s.img)} alt={en ? s.title : alt(s.img)} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} />
      </div>
    ))}
    <div class="hero-body">
      <div class="hero-text" data-hero-text style="display:flex;flex-direction:column;align-items:center;gap:18px">
        <h1>{L?.h1 ?? 'סיורים וטיולים בקולומביה, עם יונתן'}</h1>
        <p class="hero-slide-title" data-t>{slides[0].title}</p>
        <p data-s>{slides[0].sub}</p>
      </div>
      <form class="search" role="search" action={lp(lang, '/tours/')} method="get">
        <label>
          <Icon name="search" />
          <span class="sr-only">{L?.search ?? 'חיפוש טיולים'}</span>
          <input type="search" name="q" placeholder={L?.searchPh ?? 'גואטפה, אסקובר, מצפים...'} />
        </label>
        <button type="submit">{L?.searchBtn ?? 'חיפוש'}</button>
      </form>
    </div>
    <div class="dots">
      {slides.map((_, i) => <button type="button" class:list={['dot', { 'is-active': i === 0 }]} aria-label={L ? L.slide(i + 1, slides.length) : `שקופית ${i + 1} מתוך ${slides.length}`} aria-current={i === 0 ? 'true' : undefined} data-dot={i}></button>)}
    </div>
    <button type="button" class="pause-btn" aria-pressed="false" aria-label={L?.pause ?? 'עצירת הסליידר'} data-hero-pause hidden>
      <span class="ico-pause"><Icon name="pause" size={18} /></span><span class="ico-play"><Icon name="play" size={16} /></span>
    </button>
  </section>

  <section class="section wrap" data-filter-root>
    <h2 class="section-title">{L?.toursH ?? "טיולים וסיורים ממדג'ין"}</h2>
    <div class="chips" role="group" aria-label={L?.filter ?? 'סינון לפי סוג טיול'}>
      {cats.map(([k, label], i) => <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-cat={k}>{label}</button>)}
    </div>
    <p class="couples-note" data-couples-note hidden>{L?.couples ?? 'זמן לשניים, בלי לחץ ובלי קבוצה: נופים, שקיעות, חופים צלולים וחוויות שבונים סביבכם. אני מתאים לכם את הקצב, ודואג לכל השאר.'}</p>
    <div class="tour-grid swipe-row">
      {tourList.map((x) => <TourCard tour={x} lang={lang} />)}
    </div>
    <div style="text-align:center;margin-top:24px"><a href={lp(lang, '/tours/')} class="btn btn-outline">{L?.allTours ?? 'לכל הטיולים'}</a></div>
  </section>


  <section class="section-tight wrap">
    <h2 class="section-title">{L?.destH ?? 'יעדים בקולומביה'}</h2>
    <Carousel label={L?.destLabel ?? 'יעדים'} auto lang={lang}>
      {en ? destinations.filter((d) => !d.comingSoon || d.link).map((d) => (
        <a href={d.link ? lp(lang, d.link) : `/en/tours/?dest=${d.slug}`} class="dest-card card">
          <img class="zoom" src={thumb(d.image)} alt={destNamesEn[d.slug]} loading="lazy" />
          <div class="cap"><strong>{destNamesEn[d.slug]}</strong><span>{d.link ? 'Transfer from Medellín' : countFor(d.slug)}</span></div>
        </a>
      )) : destinations.map((d) => (
        d.comingSoon && d.link ? (
          <a href={d.link} class="dest-card card">
            <img class="zoom" src={thumb(d.image)} alt={d.name} loading="lazy" />
            <div class="cap"><strong>{d.name}</strong><span>{d.linkLabel}</span></div>
          </a>
        ) : d.comingSoon ? (
          <div class="dest-card">
            {d.image && <img src={thumb(d.image)} alt={d.name} loading="lazy" />}<div class="cap"><strong>{d.name}</strong><span>בקרוב</span></div>
          </div>
        ) : (
          <a href={`/destinations/${d.slug}/`} class="dest-card card">
            <img class="zoom" src={thumb(d.image)} alt={d.name} loading="lazy" />
            <div class="cap"><strong>{d.name}</strong><span>{countFor(d.slug)}</span></div>
          </a>
        )
      ))}
    </Carousel>
  </section>


  <section class="bg-cream">
    <div class="wrap section">
      <h2 class="section-title">{L?.whyH ?? 'למה לטייל איתי?'}</h2>
      <ul class="why-list">
        {why.map((w) => (
          <li>
            <span class="ico-circle" aria-hidden="true"><Icon name={w.icon} size={24} /></span>
            <span><strong>{w.title}</strong><span class="t">{w.text}</span></span>
          </li>
        ))}
      </ul>
      <nav class="svc-row" aria-label={L?.svcNav ?? 'הסעות, טיסות ותכנון טיולים'}>
        {serviceList.map((s) => (
          <a href={lp(lang, `/services/#${s.id}`)}>
            <span class="ico-circle" aria-hidden="true"><Icon name={s.icon} size={22} /></span>
            <span>{s.title}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="wrap section">
    <div class="about-strip">
      <img src={thumb('israeli-guide-medellin-yonatan')} alt={L?.meAlt ?? 'יונתן מילמן רוכב על סוס בהרי אנטיוקיה'} loading="lazy" width="160" height="160" />
      <div class="about-text">
        <h2>{L?.hi ?? 'היי, אני יונתן מילמן'}</h2>
        <p>{L?.meText ?? "אני גר במדג'ין כבר שנתיים, וקולומביה היא הבית השני שלי. כל טיול עובר דרכי: אני בונה אותו איתכם ובוחר את האנשים שילוו אתכם."}</p>
        <div class="about-btns">
          <a href={waLink(t.waDefault)} class="btn btn-yellow" target="_blank" rel="noopener">{L?.talk ?? 'דברו איתי בוואטסאפ'}</a>
          <a href={lp(lang, '/about/')} class="btn btn-outline">{L?.more ?? 'עוד עליי'}</a>
        </div>
      </div>
    </div>
  </section>

  {!en && <section class="bg-cream">
    <div class="wrap section">
      <h2 class="section-title">מאמרים לפני שטסים</h2>
      <div class="post-grid swipe-row">
        {homeGuides.map((g) => (
          <a href={`/guides/${g.slug}/`} class="post-card card">
            <div class="media"><img class="zoom" src={thumb(g.card)} alt="" loading="lazy" width="600" height="450" /></div>
            <div class="body">
              <h3>{g.title}</h3>
              <span class="sub">{g.sub}</span>
              <span class="more">לקריאה ←</span>
            </div>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:24px"><a href="/guides/" class="btn btn-outline">לכל המאמרים</a></div>
    </div>
  </section>}

  <section class="wrap section-tight" aria-labelledby="moments-title">
    <div class="moments-head">
      <h2 id="moments-title">{L?.moments ?? 'רגעים מהשטח'}</h2>
      <span><a href={site.instagram} target="_blank" rel="noopener">{t.instagram}</a> · <a href={site.tiktok} target="_blank" rel="noopener">{t.tiktok}</a></span>
    </div>
    <a href={site.instagram} class="moments" target="_blank" rel="noopener" aria-label={L?.momentsAria ?? 'עוד רגעים מהשטח באינסטגרם'}>
      {moments.map((m) => <img src={thumb(m)} alt={en ? altEn(m) : alt(m)} loading="lazy" width="300" height="400" />)}
    </a>
  </section>
  <LeadForm source={en ? 'home-en' : 'home'} lang={lang} />
</Base>

<script>
  // Hero slider: crossfade every 5.5s, pause when tab hidden or on hover.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('.hero-slide')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const text = hero.querySelector<HTMLElement>('[data-hero-text]')!;
    let i = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => { d.classList.toggle('is-active', k === i); d.toggleAttribute('aria-current', k === i); });
      text.classList.add('is-changing');
      setTimeout(() => {
        const s = slides[i].dataset;
        text.querySelector('[data-t]')!.textContent = s.title ?? '';
        text.querySelector('[data-s]')!.textContent = s.sub ?? '';
        text.classList.remove('is-changing');
      }, 300);
    };
    // stopped = the visitor pressed pause (or asked the OS for reduced motion); hover/focus only pause for a moment.
    let stopped = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stop = () => window.clearInterval(timer);
    const start = () => { stop(); if (!stopped) timer = window.setInterval(() => show(i + 1), 5500); };
    dots.forEach((d, k) => d.addEventListener('click', () => { show(k); start(); }));
    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', (e) => { if (!hero.contains(e.relatedTarget as Node)) start(); });
    const pauseBtn = hero.querySelector<HTMLButtonElement>('[data-hero-pause]');
    if (pauseBtn && !stopped) {
      pauseBtn.hidden = false;
      pauseBtn.addEventListener('click', () => {
        stopped = !stopped;
        pauseBtn.setAttribute('aria-pressed', String(stopped));
        const EN = document.documentElement.lang === 'en';
        pauseBtn.setAttribute('aria-label', stopped ? (EN ? 'Play the slider' : 'הפעלת הסליידר') : (EN ? 'Pause the slider' : 'עצירת הסליידר'));
        start();
      });
    }
    start();
  }

  // Tour category chips
  document.querySelectorAll<HTMLElement>('[data-filter-root]').forEach((root) => {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-cat]')];
    const cards = [...root.querySelectorAll<HTMLElement>('.tour-card')];
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      const cat = c.dataset.cat;
      cards.forEach((card) => { card.hidden = cat === 'couples' ? !card.hasAttribute('data-couples') : cat !== 'all' && card.dataset.kind !== cat; });
      const note = root.querySelector<HTMLElement>('[data-couples-note]');
      if (note) note.hidden = cat !== 'couples';
      root.querySelector('.swipe-row')?.scrollTo({ left: 0 });
    }));
  });
</script>

<style>
  .hero-slide-title { font-size: clamp(22px, 3vw, 30px) !important; font-weight: 700; }
  .section-tight { padding-top: 8px; padding-bottom: 48px; }
  .svc-row { margin: 32px auto 0; max-width: 1000px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .svc-row a { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; padding: 14px 8px; border-radius: var(--radius); background: #fff; border: 1px solid var(--line); color: var(--ink); text-decoration: none; font-size: 14px; font-weight: 600; line-height: 1.3; }
  .svc-row a:hover { border-color: var(--blue); color: var(--blue); }
  .about-strip { display: flex; align-items: center; gap: 28px; max-width: 900px; margin: 0 auto; }
  .about-strip img { width: 160px; height: 160px; flex: 0 0 auto; object-fit: cover; object-position: 40% 55%; border-radius: 50%; border: 4px solid var(--yellow); }
  .about-text { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .about-text h2 { font-size: clamp(24px, 3.5vw, 32px); }
  .about-text p { font-size: 17px; line-height: 1.65; color: var(--text); }
  .about-btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; max-width: 1000px; margin: 0 auto; }
  .moments-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 14px; }
  .moments-head h2 { font-size: clamp(22px, 3vw, 28px); }
  .moments-head span { font-weight: 600; }
  .moments { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .moments img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 12px; }
  @media (max-width: 700px) {
    .svc-row { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 24px; }
    .about-strip { flex-direction: column; text-align: center; gap: 16px; }
    .about-strip img { width: 120px; height: 120px; }
    .about-btns { justify-content: center; }
    .moments { gap: 6px; }
    .moments img { border-radius: 8px; }
  }
</style>
