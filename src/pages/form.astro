---
// Standalone client intake page: medejoni.com/form/
// Jonathan sends this link to new clients. Same look as the first version of the form (logo, flag stripe,
// full-screen steps), without the site's header and footer. Answers post to the server as form-name
// "trip-planning", so they are emailed to Jonathan like the form on /services/#trip-planning.
// Kept out of Google and the sitemap (see `hidden` in astro.config.mjs).
import '@fontsource-variable/rubik/wght.css';
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#FCD116">
<title>טופס היכרות | Medejoni</title>
<meta name="description" content="כמה שאלות קצרות לפני שמתכננים לכם טיול בקולומביה.">
<meta property="og:title" content="בואו נכיר לפני שמתכננים | Medejoni">
<meta property="og:description" content="קחו 5 דקות ותמלאו את הטופס, כדי שנכיר אתכם הכי טוב שאפשר.">
<meta property="og:image" content="https://medejoni.com/images/logo-224.webp">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<style is:global>
/* VOICE everyday, warm and personal
   IDEA a travel questionnaire card handed over by a local friend, in Colombian flag colours
   PICTURE the round Medejoni logo over a flag-striped band, then the step card itself
   COLOUR white ground, navy ink #0d1b3d, warm yellow #fcd116 for chosen chips, flag blue and red as thin accents
   TYPE Rubik 800 titles + Rubik 400/500 text
   LAYOUT one centered column max 640px; on phone the card fills the width, next/back bar sticky at bottom */
:root{color-scheme:light dark;--bg:light-dark(#ffffff,#0b1326);--card:light-dark(#fffdf4,#121d38);--ink:light-dark(#0d1b3d,#f3f5fb);--mute:light-dark(#55607a,#aab3c8);--line:light-dark(#e3e6ee,#2a3658);--y:#fcd116;--yd:light-dark(#f4c400,#fcd116);--ysoft:light-dark(#fff6cc,#3a3313);--blue:#1f4bb5;--red:#ce1126;--chip:light-dark(#ffffff,#18244a)}
:root[data-theme=light]{color-scheme:light}:root[data-theme=dark]{color-scheme:dark}
*{box-sizing:border-box;min-width:0}
html,body{direction:rtl}
body{background:var(--bg);color:var(--ink);font:16px/1.55 "Rubik Variable",Rubik,"Segoe UI",Arial,sans-serif;overflow-x:clip;margin:0}
.flag{height:8px;background:linear-gradient(to bottom,var(--y) 0 50%,var(--blue) 50% 75%,var(--red) 75%)}
header{text-align:center;padding:22px max(5vw,16px) 8px}
body.later header .lead{display:none}body.later header img{width:72px;height:72px}body.later h1{font-size:22px;margin-top:8px}
header img{width:104px;height:104px;border-radius:50%;box-shadow:0 0 0 4px var(--y)}
h1{font-weight:800;font-size:clamp(26px,6vw,36px);line-height:1.1;letter-spacing:-.01em;margin:14px 0 6px}
.lead{color:var(--mute);margin:0 auto;max-width:34em}
main{max-width:640px;margin:0 auto;padding:12px max(4vw,16px) 120px}
.prog{display:flex;gap:4px;margin:10px 0 6px}
.prog i{flex:1;height:6px;border-radius:3px;background:var(--line)}
.prog i.on{background:var(--yd)}
.stepno{font-size:14px;color:var(--mute);margin-bottom:8px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:20px clamp(16px,4vw,26px)}
.card h2{font-size:24px;font-weight:800;margin:0 0 4px}
.card .sub{color:var(--mute);margin:0 0 10px;font-size:15px}
.q{margin-top:18px}
.q>label,.q>.lbl{display:block;font-weight:700;margin-bottom:8px}
.q .hint{font-weight:400;color:var(--mute);font-size:14px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{font:inherit;font-size:15px;color:var(--ink);background:var(--chip);border:1.5px solid var(--line);border-radius:999px;padding:9px 15px;min-height:44px;cursor:pointer;transition:background .15s,border-color .15s}
.chip:hover{border-color:var(--yd)}
.chip[aria-pressed=true]{background:var(--y);border-color:var(--y);color:#0d1b3d;font-weight:600}
.chip:focus-visible,.btn:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
input,textarea{font:inherit;font-size:16px;width:100%;color:var(--ink);background:var(--chip);border:1.5px solid var(--line);border-radius:12px;padding:11px 13px}
textarea{min-height:84px;resize:vertical}
input[type=tel],input[type=email]{direction:ltr;text-align:right}
.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}
.err{color:var(--red);font-size:14px;margin-top:6px}
.bar{position:fixed;inset-inline:0;bottom:0;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(6px);border-top:1px solid var(--line);padding:12px max(4vw,16px) calc(12px + env(safe-area-inset-bottom,0px))}
.bar .in{max-width:640px;margin:0 auto;display:flex;gap:10px}
.btn{font:inherit;font-weight:700;font-size:17px;border-radius:14px;padding:13px 20px;min-height:50px;cursor:pointer;border:1.5px solid var(--line);background:var(--chip);color:var(--ink)}
.btn.main{flex:1;background:var(--y);border-color:var(--y);color:#0d1b3d}
.btn.main:hover{background:#ffdc3d}
.done{text-align:center}
.done .big{font-size:56px;line-height:1}
.wa{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#25d366;color:#fff;text-decoration:none;font-weight:700;font-size:17px;border-radius:14px;padding:14px 22px;min-height:52px;margin-top:14px}
.sum{text-align:right;white-space:pre-wrap;background:var(--chip);border:1px solid var(--line);border-radius:12px;padding:14px;font-size:14px;margin-top:16px;max-height:280px;overflow:auto}
.small{font-size:14px;color:var(--mute)}
@media(max-width:420px){.two{grid-template-columns:minmax(0,1fr)}}
@media(prefers-reduced-motion:reduce){.chip{transition:none}}
[hidden]{display:none!important}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
</head>
<body>
<div class="flag"></div>
<header>
  <img src="/images/logo-224.webp" alt="Medejoni">
  <h1>בואו נכיר לפני שמתכננים</h1>
  <p class="lead">קחו 5 דקות ותמלאו את הטופס, כדי שנכיר אתכם הכי טוב שאפשר. רוב התשובות בלחיצה אחת.</p>
</header>

<main>
  <div class="prog" id="prog"></div>
  <div class="stepno" id="stepno"></div>
  <form id="f" class="card" novalidate><noscript>כדי למלא את הטופס צריך להפעיל JavaScript, או לכתוב לי ישירות בוואטסאפ: +57 313 509 0957</noscript></form>
  <p hidden aria-hidden="true"><label>Leave empty <input id="hp_field" tabindex="-1" autocomplete="off"></label></p>
</main>

<div class="bar" id="bar"><div class="in">
  <button class="btn" id="back" type="button">חזרה</button>
  <button class="btn main" id="next" type="button">הבא</button>
</div></div>
<script is:inline>
{
const PHONE='573135090957';
// q: id, t: title, type: one|many|text|tel|email|date|area, o: options, req, show: fn(state)
const STEPS=[
 {h:'מי אתם',s:'כדי שאדע איך לחזור אליכם.',q:[
  {id:'name',key:'name',t:'שם מלא',type:'text',req:1},
  {id:'phone',key:'phone',t:'מספר וואטסאפ',type:'tel',req:1,hint:'עם קידומת מדינה'},
  {id:'email',key:'email',t:'אימייל',type:'email',hint:'לא חובה'},
  {id:'from',t:'מאיפה אתם',type:'one',o:['ישראל','חו״ל']}]},
 {h:'מי מטייל',s:'',q:[
  {id:'count',t:'כמה אתם',type:'one',req:1,o:['1','2','3 עד 4','5 עד 8','9+']},
  {id:'group',t:'מי נוסע',type:'one',o:['זוג','משפחה עם ילדים','חברים','לבד','מסיבת רווקים / רווקות','קבוצה']},
  {id:'ages',t:'גילאים',hint:'אפשר לבחור כמה',type:'many',req:1,o:['ילדים עד 12','נוער 13 עד 17','18 עד 30','30 עד 45','45 עד 60','60+']},
  {id:'occasion',t:'יש אירוע מיוחד?',type:'one',o:['אין','ירח דבש','יום הולדת','אחרי צבא','פרישה','אחר']}]},
 {h:'מתי וכמה זמן',s:'',q:[
  {id:'datesKnown',t:'יש כבר תאריכים?',type:'one',req:1,o:['סגורים','בערך','עוד לא']},
  {id:'arrive',t:'תאריך הגעה',type:'date',show:s=>s.datesKnown&&s.datesKnown!=='עוד לא'},
  {id:'leave',t:'תאריך יציאה',type:'date',show:s=>s.datesKnown&&s.datesKnown!=='עוד לא'},
  {id:'month',t:'חודש משוער',type:'one',show:s=>s.datesKnown==='עוד לא',o:['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר']},
  {id:'length',t:'משך הטיול',type:'one',req:1,o:['עד שבוע','1 עד 2 שבועות','2 עד 3 שבועות','3 שבועות ומעלה']}]},
 {h:'הסגנון שלכם',s:'אין תשובה נכונה, זה רק כדי לכוון את הקצב.',q:[
  {id:'pace',t:'קצב הטיול',type:'one',req:1,o:['רגוע','בינוני','אקסטרים']},
  {id:'days',t:'איך נראים הימים',type:'one',o:['הרבה זמן חופשי','שילוב','לוח מלא']},
  {id:'guide',t:'סיורים',type:'one',o:['פרטיים','קבוצתיים','שילוב','עצמאי ברובו']}]},
 {h:'מה מעניין אתכם',s:'בחרו כמה שרוצים.',q:[
  {id:'interests',t:'תחומי עניין',type:'many',req:1,o:['טבע ונופים','חופים והים הקריבי','ג׳ונגל','טרקים','אקסטרים (מצנחי רחיפה, רפטינג, טרקטורונים)','היסטוריה ופבלו אסקובר','אומנות רחוב וקומונה 13','קפה וחוות','אוכל מקומי','חיי לילה ומסיבות','סלסה','כדורגל','בעלי חיים וציפורים','כפרים קטנים','צילום','ספא ורוגע']},
  {id:'places',t:'מקומות שכבר בראש',type:'many',o:['מדג׳ין','גואטפה','קרטחנה','סנטה מרתה וטאיירונה','מינקה','סלנטו ואזור הקפה','בוגוטה','ז׳רדין','האמזונס','לא יודעים, תמליץ לי']}]},
 {h:'לינה ותקציב',s:'',q:[
  {id:'lodging',t:'סגנון לינה',hint:'אפשר לבחור כמה',type:'many',o:['הוסטל','מלון בוטיק','מלון רגיל','דירה','יוקרה','שילוב']},
  {id:'rooms',t:'חדרים',type:'one',o:['חדר משותף','חדר לכל זוג','חדר לכל אחד']},
  {id:'budget',t:'תקציב לאדם ליום, בלי טיסות',type:'one',o:['עד 50$','50 עד 100$','100 עד 200$','200$ ומעלה','עוד לא יודעים']}]},
 {h:'מה כבר סגור',s:'כדי שאשמור על מה שכבר הזמנתם.',q:[
  {id:'intlFlight',t:'טיסה לקולומביה',type:'one',o:['הוזמנה','עוד לא','רוצים עזרה']},
  {id:'domFlight',t:'טיסות פנים',type:'one',o:['הוזמנו','עוד לא','רוצים עזרה']},
  {id:'hotels',t:'לינות',type:'one',o:['חלק הוזמנו','הכול הוזמן','עוד לא']},
  {id:'transfer',t:'הסעה משדה התעופה',type:'one',o:['צריך','לא צריך','לא בטוחים']},
  {id:'booked',t:'פרטים על מה שהוזמן',type:'area',hint:'טיסות, שעות, מלונות. לא חובה',show:s=>[s.intlFlight,s.domFlight,s.hotels].some(v=>v&&v.startsWith('הוזמ')||v==='חלק הוזמנו'||v==='הכול הוזמן')}]},
 {h:'אוכל, בריאות ושפה',s:'',q:[
  {id:'food',t:'אוכל',hint:'אפשר לבחור כמה',type:'many',o:['אוכלים הכול','צמחוני','טבעוני','כשר','בלי גלוטן','אלרגיות']},
  {id:'allergy',t:'לאיזה מאכלים יש אלרגיה?',type:'text',show:s=>(s.food||[]).includes('אלרגיות')},
  {id:'limits',t:'מגבלות',hint:'אפשר לבחור כמה',type:'many',o:['אין','קושי בהליכה','גב או ברכיים','פחד גבהים','מחלת ים','אחר']},
  {id:'langs',t:'שפות שאתם מדברים',hint:'אפשר לבחור כמה',type:'many',o:['עברית','אנגלית','ספרדית']}]},
 {h:'כמעט סיימנו',s:'',q:[
  {id:'source',key:'heard_from',t:'איך הגעתם אליי',type:'one',o:['אינסטגרם','טיקטוק','אפליקציית הגל','חבר המליץ','גוגל','האתר','אחר']},
  {id:'notes',key:'notes',t:'משהו שחשוב שאדע?',type:'area',hint:'חלומות, חששות, דברים שאתם לא רוצים'}]}
];
const S={};let cur=0;
const $=id=>document.getElementById(id);
const esc=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const vis=q=>!q.show||q.show(S);
function field(q){
 const lab=`${esc(q.t)}${q.req?' *':''}${q.hint?` <span class="hint">${esc(q.hint)}</span>`:''}`;
 if(q.type==='one'||q.type==='many'){
  const sel=q.type==='one'?[S[q.id]]:(S[q.id]||[]);
  return `<div class="q" data-q="${q.id}"><span class="lbl" id="l_${q.id}">${lab}</span><div class="chips" role="group" aria-labelledby="l_${q.id}">${q.o.map(o=>`<button type="button" class="chip" data-id="${q.id}" data-v="${esc(o)}" aria-pressed="${sel.includes(o)}">${esc(o)}</button>`).join('')}</div></div>`;
 }
 const v=esc(S[q.id]||'');
 const inp=q.type==='area'?`<textarea id="i_${q.id}" data-id="${q.id}">${v}</textarea>`:`<input id="i_${q.id}" data-id="${q.id}" type="${q.type}" value="${v}"${q.type==='tel'?' inputmode="tel" autocomplete="tel"':''}${q.type==='text'&&q.id==='name'?' autocomplete="name"':''}>`;
 return `<div class="q" data-q="${q.id}"><label for="i_${q.id}">${lab}</label>${inp}</div>`;
}
function render(){
 const f=$('f');
 $('prog').innerHTML=STEPS.map((_,i)=>`<i class="${i<=cur?'on':''}"></i>`).join('');
 document.body.classList.toggle('later',cur>0);
 const st=STEPS[cur];
 $('stepno').textContent=`שלב ${cur+1} מתוך ${STEPS.length}`;
 const qs=st.q.filter(vis);
 const dates=qs.filter(q=>q.type==='date');
 let body=qs.filter(q=>q.type!=='date').map(field);
 if(dates.length){const at=qs.findIndex(q=>q.type==='date');body.splice(at,0,`<div class="two">${dates.map(field).join('')}</div>`)}
 f.innerHTML=`<h2>${esc(st.h)}</h2>${st.s?`<p class="sub">${esc(st.s)}</p>`:''}${body.join('')}`;
 $('back').hidden=cur===0;
 $('next').textContent=cur===STEPS.length-1?'שליחה':'הבא';
 save();
}
function check(){
 const bad=STEPS[cur].q.filter(vis).filter(q=>{
  const v=S[q.id];if(q.type==='email')return !!v&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(v).trim());if(!q.req)return false;
  if(Array.isArray(v))return !v.length;
  if(q.type==='tel')return !v||v.replace(/\D/g,'').length<8;
  return !v||!String(v).trim();
 });
 document.querySelectorAll('.err').forEach(e=>e.remove());
 bad.forEach(q=>{const el=document.querySelector(`[data-q="${q.id}"]`);if(el){const e=document.createElement('div');e.className='err';e.textContent=q.type==='tel'?'צריך מספר וואטסאפ תקין':q.type==='email'?'כתובת המייל לא תקינה':'צריך לענות על זה';el.appendChild(e)}});
 if(bad.length){const el=document.querySelector(`[data-q="${bad[0].id}"]`);el&&el.scrollIntoView({behavior:'smooth',block:'center'})}
 return !bad.length;
}
function fmtDate(v){if(!v)return'';const[y,m,d]=v.split('-');return `${+d}.${+m}.${y}`}
function summary(){
 const L=['שלום יונתן, מילאתי את טופס ההיכרות של מדג׳וני 🙂',''];
 STEPS.forEach(st=>{
  const rows=st.q.filter(vis).map(q=>{let v=S[q.id];if(Array.isArray(v))v=v.join(', ');if(q.type==='date')v=fmtDate(v);return v&&String(v).trim()?`${q.t}: ${String(v).trim()}`:null}).filter(Boolean);
  if(rows.length){L.push(`*${st.h}*`,...rows,'')}
 });
 return L.join('\n').trim();
}
function answers(){return STEPS.flatMap(st=>st.q).filter(vis).map(q=>{let v=S[q.id];if(Array.isArray(v))v=v.join(', ');if(q.type==='date')v=fmtDate(v||'');return [q,String(v??'').trim()]}).filter(x=>x[1])}
function waUrl(){return 'https://wa.me/'+PHONE+'?text='+encodeURIComponent(summary())}
function finish(ok,tooMany){
 $('stepno').textContent='';$('bar').hidden=true;
 $('prog').innerHTML=STEPS.map(()=>'<i class="on"></i>').join('');
 const first=esc(String(S.name||'').trim().split(/\s+/)[0]);
 $('f').innerHTML=ok
  ?`<div class="done"><div class="big">💛</div><h2>תודה${first?', '+first:''}!</h2><p class="sub">קיבלתי את כל הפרטים, ואחזור אליכם בוואטסאפ תוך 24 שעות.</p><a class="wa" href="${esc(waUrl())}" target="_blank" rel="noopener">רוצים לדבר כבר עכשיו? לוואטסאפ</a></div>`
  :`<div class="done"><h2>${tooMany?'כבר קיבלתי מכם פנייה ממש עכשיו':'משהו השתבש בשליחה'}</h2><p class="sub">${tooMany?'אם תרצו להוסיף משהו,':'כדי שהתשובות לא ילכו לאיבוד,'} שלחו לי אותן בלחיצה בוואטסאפ:</p><a class="wa" href="${esc(waUrl())}" target="_blank" rel="noopener">שליחת התשובות בוואטסאפ</a><p class="small">וואטסאפ ‎+57 313 509 0957</p></div>`;
 window.scrollTo({top:0,behavior:'smooth'});
}
async function send(){
 const btn=$('next');btn.disabled=true;btn.textContent='שולח...';
 const data=new URLSearchParams();
 data.set('form-name','trip-planning');data.set('hp_field',$('hp_field').value);
 answers().forEach(([q,v])=>data.set(q.key||q.t,v));
 try{const p=JSON.parse(localStorage.getItem('mj_partner')||'null');if(p&&p.until>Date.now())data.set('partner',p.code)}catch(e){}
 try{
  const res=await fetch('/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:data.toString()});
  if(res.status===429)return finish(false,true);
  if(!res.ok)throw new Error(res.status);
  try{localStorage.removeItem('mdj_intake')}catch(e){}
  window.gtag&&window.gtag('event','generate_lead',{form_name:'trip-planning'});
  finish(true);
 }catch(e){finish(false)}
 finally{btn.disabled=false;btn.textContent='שליחה'}
}
function save(){try{localStorage.setItem('mdj_intake',JSON.stringify({S,cur}))}catch(e){}}
$('f').addEventListener('click',e=>{
 const b=e.target.closest('.chip');if(!b)return;
 const id=b.dataset.id,v=b.dataset.v,q=STEPS.flatMap(s=>s.q).find(x=>x.id===id);
 if(q.type==='one'){S[id]=S[id]===v?undefined:v}
 else{let a=S[id]||[];const ex=['אין','אוכלים הכול','רק קולומביה','עוד לא יודעים','לא יודעים, תמליץ לי'];
  if(a.includes(v))a=a.filter(x=>x!==v);else{a=ex.includes(v)?[v]:a.filter(x=>!ex.includes(x)).concat(v)}S[id]=a}
 const y=window.scrollY;render();window.scrollTo(0,y);
});
$('f').addEventListener('input',e=>{const id=e.target.dataset.id;if(id){S[id]=e.target.value;save()}});
$('f').addEventListener('submit',e=>e.preventDefault());
$('next').onclick=()=>{
 if(!check())return;
 if(cur===STEPS.length-1){send();return}
 cur++;render();window.scrollTo({top:0,behavior:'smooth'});
};
$('back').onclick=()=>{if(cur>0){cur--;render();window.scrollTo({top:0,behavior:'smooth'})}};
try{const d=JSON.parse(localStorage.getItem('mdj_intake')||'null');if(d&&d.S){Object.assign(S,d.S);cur=Math.min(d.cur||0,STEPS.length-1)}}catch(e){}
render();
}
