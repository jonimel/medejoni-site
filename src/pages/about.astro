---
import { alt } from '../data/photos';
import Base from '../layouts/Base.astro';
import { img, waLink } from '../data/site';

const steps = [
  { title: 'קולומביה אותנטית', text: 'המקומות, האנשים והטעמים שאני חי כאן כל יום, לא מה שמופיע בכל מדריך.' },
  { title: 'הכל דרכי', text: 'אני בונה איתכם את הטיול, בוחר מי ילווה אתכם ונשאר זמין לאורך כל הדרך.' },
  { title: 'מחירים הוגנים', text: 'מחירים של מקומי, בלי תיווך של סוכנות.' },
];
// Real reviews only (confirmed by Jonathan). Add new ones to this list.
const reviews = [
  { text: 'הגענו לקולומביה עם הרבה אי וודאות, דיברנו עם יונתן והכל היה כל כך קל. הוא סידר לנו טיול לגואטפה, שטנו באגם ואכלנו במקום מקומי שלא היינו מוצאים לבד. הרגשנו כמו עם חבר שגר פה.', who: 'מיכל, 23 · טיול לגואטפה', stars: 5 },
  { text: 'רצינו יום שייתן לנו להכיר את קולומביה מעבר למקומות הרגילים, וזה בדיוק מה שקיבלנו. אוכל מקומי, נופים וסיפורים קטנים שעזרו לנו להבין את החיים פה. יונתן היה קשוב לקצב שלנו ויצר אווירה ממש נעימה. חזרנו עם תחושה שהכרנו עוד צד של קולומביה.', who: 'מאור, 22', stars: 5 },
  { text: 'בעלי ואני הגענו ליונתן עם רשימה ארוכה של מקומות שרצינו לראות ובלי מושג איך לחבר ביניהם. הוא עזר לנו לבנות מסלול שמתאים לזמן, לתקציב ולסגנון שלנו, וגם אמר בכנות על מה כדאי לוותר. במהלך הטיול הבנו כמה התכנון הזה עזר — המעברים היו הגיוניים, היה זמן לנוח ולא הרגשנו שאנחנו כל היום עם המזוודות. חסך לנו המון התלבטויות.', who: 'אלה, 38 · תכנון מסלול', stars: 5 },
  { text: 'אני וכמה חברים סגרנו עם יונתן יום של רכיבה על סוסים ופיינטבול והיה פשוט כיף! התחלנו ברכיבה מול נופים מדהימים, ואחר כך פיינטבול. יונתן דאג לארגון ולאווירה, ואנחנו רק היינו צריכים להגיע וליהנות. יום מלא צחוקים וחוויות שאנחנו עדיין מדברים עליו!', who: 'שלומית, 24 · סוסים ופיינטבול', stars: 5 },
];
---
<Base title="מי אני – יונתן מילמן, ישראלי במדג'ין" description="היי, אני יונתן מילמן, ישראלי שגר במדג'ין. אני מראה לכם את קולומביה האותנטית, כמו שהמקומיים חיים אותה, ומלווה אתכם אישית לאורך כל הטיול." image={img('israeli-guide-medellin-yonatan')} nav="about">
  <section class="page-top">
    <div class="wrap a-hero">
      <div style="display:flex;flex-direction:column;gap:18px">
        <span class="pill pill-blue" style="align-self:flex-start">מי אני</span>
        <h1 style="font-size:clamp(40px,6vw,56px);line-height:1.1;font-weight:800">היי, אני יונתן.<br />ישראלי שגר במדג'ין.</h1>
        <p style="font-size:20px;line-height:1.7;max-width:560px">קולומביה היא הבית שלי. אני רוצה שתחוו אותה כמו שאני חי אותה: מקומית, אמיתית, עם האנשים והמקומות שאני מכיר. ואני איתכם לאורך כל הדרך.</p>
        <p style="font-size:18px;line-height:1.7;max-width:560px">גם אם אתם מוצ'ילרים אחרי צבא, במסיבת רווקים או פנסיונרים שיוצאים לחוות, אני אתכנן בשבילכם חוויה נעימה שמתאימה בדיוק לכם.</p>
        <a href={waLink()} class="btn btn-dark" style="align-self:flex-start" target="_blank" rel="noopener">דברו איתי בוואטסאפ</a>
      </div>
      <div class="mosaic">
        <img src={img('israeli-guide-medellin-yonatan')} alt="יונתן מילמן רוכב על סוס בהרי אנטיוקיה" sizes="(max-width: 900px) 100vw, 40vw" style="grid-row:span 2;object-position:40% 50%" />
        <img src={img('medellin-for-travelers-aburra-valley')} alt={alt('medellin-for-travelers-aburra-valley')} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" />
        <img src={img('private-tour-medellin-fishing')} alt={alt('private-tour-medellin-fishing')} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">איך אני עובד</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px">
      {steps.map((s, i) => (
        <div class="reveal" style={`border:1px solid var(--line);border-radius:20px;padding:28px;display:flex;flex-direction:column;gap:10px;transition-delay:${i * 100}ms`}>
          <span class="deco-num" aria-hidden="true" data-n={`0${i + 1}`} style="font-size:44px"></span>
          <strong style="font-size:21px">{s.title}</strong>
          <span style="font-size:17px;line-height:1.6;color:#4B5563">{s.text}</span>
        </div>
      ))}
    </div>
  </section>

  <section style="background:var(--sky)" data-reviews>
    <div class="wrap section" style="max-width:900px;text-align:center;display:flex;flex-direction:column;gap:24px;align-items:center">
      <h2 style="font-size:34px">מה מטיילים אומרים</h2>
      <div class="rv-track" aria-live="polite">
        {reviews.map((r, i) => (
          <figure class:list={['rv', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
            <div class="stars" role="img" aria-label={`דירוג ${r.stars} מתוך 5 כוכבים`}>{'★'.repeat(r.stars)}</div>
            <blockquote>“{r.text}”</blockquote>
            <figcaption>{r.who}</figcaption>
          </figure>
        ))}
      </div>
      {reviews.length > 1 && <div style="display:flex;gap:10px;align-items:center">
        <button type="button" class="rv-btn" aria-label="ההמלצה הקודמת" data-rv-prev>›</button>
        {reviews.map((_, i) => <span aria-hidden="true" class:list={['rv-dot', { 'is-active': i === 0 }]}></span>)}
        <button type="button" class="rv-btn" aria-label="ההמלצה הבאה" data-rv-next>‹</button>
      </div>}
    </div>
  </section>

  <section class="wrap section photo-grid">
    <img src={img('jardin-horseback-riding')} alt={alt('jardin-horseback-riding')} sizes="(max-width: 900px) 100vw, 60vw" loading="lazy" style="grid-column:span 2;grid-row:span 2" />
    <img src={img('jardin-cave-waterfall')} alt={alt('jardin-cave-waterfall')} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" />
    <img src={img('medellin-restaurants-watermelon')} alt={alt('medellin-restaurants-watermelon')} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" style="grid-row:span 2" />
    <img src={img('guatape-day-trip-umbrella-street')} alt={alt('guatape-day-trip-umbrella-street')} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" />
  </section>
</Base>

<style>
  .a-hero { padding-top: 64px; padding-bottom: 64px; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 48px; align-items: center; }
  .mosaic { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 200px 200px; gap: 12px; }
  .mosaic img { width: 100%; height: 100%; object-fit: cover; border-radius: 22px; border: 5px solid #fff; box-shadow: 0 6px 18px rgba(20, 27, 45, 0.12); }
  .rv-track { display: grid; width: 100%; overflow: hidden; }
  .rv { grid-area: 1 / 1; margin: 0; opacity: 0; transform: translateX(-20px); transition: opacity 500ms ease, transform 500ms ease; }
  .rv.is-active { opacity: 1; transform: none; }
  .rv blockquote { margin: 0; font-size: 21px; line-height: 1.6; font-weight: 500; }
  .stars { color: #F5B301; font-size: 24px; letter-spacing: 4px; margin-bottom: 10px; }
  .rv figcaption { margin-top: 12px; color: #4B5563; }
  .rv-btn { width: 44px; height: 44px; border-radius: 50%; border: 1px solid #D1D5DB; background: #fff; cursor: pointer; font-size: 20px; }
  .rv-dot { height: 8px; width: 8px; border-radius: 999px; background: #C7D2E8; transition: all 300ms ease; }
  .rv-dot.is-active { width: 24px; background: var(--blue); }
  .photo-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 200px; gap: 12px; }
  .photo-grid img { width: 100%; height: 100%; object-fit: cover; border-radius: 18px; border: 5px solid #fff; box-shadow: 0 6px 18px rgba(20, 27, 45, 0.12); }
  @media (max-width: 900px) {
    .a-hero { grid-template-columns: minmax(0, 1fr); }
    .photo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 160px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-reviews]');
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>('.rv')];
    const dots = [...root.querySelectorAll<HTMLElement>('.rv-dot')];
    let i = 0;
    const show = (n: number) => {
      i = (n + items.length) % items.length;
      items.forEach((x, k) => { x.classList.toggle('is-active', k === i); x.setAttribute('aria-hidden', String(k !== i)); });
      dots.forEach((d, k) => d.classList.toggle('is-active', k === i));
    };
    root.querySelector('[data-rv-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-rv-next]')?.addEventListener('click', () => show(i + 1));
  }
</script>
