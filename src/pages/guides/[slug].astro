---
import Base from '../../layouts/Base.astro';
import { guides, type Guide } from '../../data/guides';
import { getTour, fromPrice, hasTiers } from '../../data/tours';
import { formatCOP, img, waLink, site } from '../../data/site';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
interface Props { guide: Guide }
const { guide } = Astro.props;
const articles = import.meta.glob<{ Content: any; getHeadings: () => { depth: number; slug: string; text: string }[] }>('../../articles/*.md', { eager: true });
const article = guide.markdown ? articles[`../../articles/${guide.slug}.md`] : undefined;
const Content = article?.Content;
const toc = article
  ? article.getHeadings().filter((h) => h.depth === 2).map((h) => ({ id: h.slug, title: h.text }))
  : guide.sections.map((s) => ({ id: s.id, title: s.title }));
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  image: new URL(img(guide.image), Astro.site).toString(),
  author: { '@type': 'Person', name: 'Yonatan Milman' },
  inLanguage: 'he',
};
---
<Base title={guide.seoTitle ?? guide.title} description={guide.description} image={img(guide.image)} nav="guides" jsonLd={ld}>
  <article>
    <div class="wrap" style="max-width:880px;padding-top:24px;display:flex;flex-direction:column;gap:14px">
      <nav class="crumbs" aria-label="פירורי לחם" style="padding:0"><a href="/">דף הבית</a> › <a href="/guides/">מאמרים</a> › {guide.title}</nav>
      <span class="pill pill-soft" style="align-self:flex-start">{guide.tag}</span>
      <h1 style="font-size:clamp(32px,5vw,46px);font-weight:800">{guide.title}</h1>
      <p style="font-size:20px;line-height:1.6;color:#4B5563">{guide.description}</p>
      <div style="display:flex;align-items:center;gap:12px">
        <img src={img('yonatan')} alt="" style="width:44px;height:44px;border-radius:50%;object-fit:cover;object-position:38% 45%" />
        <span style="display:flex;flex-direction:column;font-size:14px"><strong style="font-size:15px">{site.owner}</strong><span style="color:var(--muted)">גר במדג'ין</span></span>
      </div>
    </div>
    <div class="wrap" style="max-width:1100px;margin-top:24px">
      <img src={img(guide.image)} alt="" style="width:100%;height:clamp(260px,40vw,500px);object-fit:cover;border-radius:24px" />
    </div>

    <div class="wrap a-layout">
      <aside class="toc" aria-label="תוכן עניינים">
        <strong>במאמר הזה</strong>
        {toc.map((s) => <a href={`#${s.id}`} data-toc={s.id}>{s.title}</a>)}
      </aside>
      <div class="prose">
        {Content && <div class="md"><Content /></div>}
        {guide.sections.map((s) => (
          <section id={s.id} data-sec>
            <h2>{s.title}</h2>
            {s.paragraphs.map((p) => <p>{p}</p>)}
            {s.image && <img src={img(s.image)} alt="" loading="lazy" />}
            {s.tip && <div class="tip"><strong>טיפ של יונתן:</strong> {s.tip}</div>}
            {s.tours && (
              <div class="embeds">
                {s.tours.map(getTour).filter(Boolean).map((t) => (
                  <a href={`/tours/${t!.slug}/`} class="card">
                    <img src={img(t!.images[0])} alt="" loading="lazy" />
                    <div><strong>{t!.title}</strong><span>{hasTiers(t!) ? 'החל מ־' : ''}{formatCOP(fromPrice(t!))} לאדם</span><span style="color:var(--blue);font-weight:600">להזמנה ←</span></div>
                  </a>
                ))}
              </div>
            )}
          </section>
        ))}
        <div class="cta">
          <div><strong>{guide.markdown ? 'רוצים שאבנה לכם את המסלול?' : 'רוצים שיונתן יתכנן לכם את היום?'}</strong><span>{guide.markdown ? 'השאירו פרטים, ואחזור אליכם אישית עם הצעה.' : 'שלחו לי הודעה, ואענה לכם אישית.'}</span></div>
          {guide.markdown
            ? <a href="/services/#trip-planning" class="btn btn-yellow">לתכנון הטיול</a>
            : <a href={waLink()} class="btn btn-yellow" target="_blank" rel="noopener">וואטסאפ</a>}
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .a-layout { max-width: 1100px; padding-top: 40px; padding-bottom: 72px; display: grid; grid-template-columns: 240px 1fr; gap: 48px; align-items: start; }
  .toc { position: sticky; top: 90px; border: 1px solid var(--line); border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .toc a { text-decoration: none; color: var(--text); border-inline-start: 3px solid transparent; padding-inline-start: 10px; transition: all 200ms ease; }
  .toc a.is-active { color: var(--blue); font-weight: 600; border-color: var(--yellow); }
  .prose { font-size: 19px; line-height: 1.85; color: #1F2937; display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .prose section { display: flex; flex-direction: column; gap: 18px; scroll-margin-top: 90px; }
  .prose h2 { font-size: 30px; line-height: 1.3; margin-top: 12px; }
  .prose img { width: 100%; height: 360px; object-fit: cover; border-radius: 20px; border: 5px solid #fff; box-shadow: 0 6px 18px rgba(20, 27, 45, 0.12); }
  .tip { background: var(--cream); border-inline-start: 5px solid var(--yellow); border-radius: 12px; padding: 16px 20px; font-size: 17px; line-height: 1.6; }
  .embeds { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .embeds a { text-decoration: none; color: inherit; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; }
  .embeds img { height: 150px; border-radius: 0; }
  .embeds div { padding: 14px; display: flex; flex-direction: column; gap: 4px; font-size: 16px; line-height: 1.4; }
  .embeds strong { font-size: 18px; }
  .cta { background: linear-gradient(250deg, #FFF3C4 0%, #EEF3FC 100%); color: var(--ink); border-radius: 20px; padding: 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; line-height: 1.5; margin-top: 12px; }
  .cta div { display: flex; flex-direction: column; gap: 4px; }
  .cta strong { font-size: 21px; }
  .cta span { font-size: 16px; color: var(--text); }
  .md { display: flex; flex-direction: column; gap: 18px; }
  .md :global(h2) { font-size: 30px; line-height: 1.3; margin-top: 18px; scroll-margin-top: 90px; }
  .md :global(h3) { font-size: 22px; line-height: 1.4; margin-top: 6px; }
  .md :global(p) { margin: 0; }
  .md :global(a) { color: var(--link); font-weight: 600; }
  .md :global(ul) { margin: 0; padding-inline-start: 22px; display: flex; flex-direction: column; gap: 6px; font-size: 16px; }
  .md :global(img) { width: 100%; height: 360px; object-fit: cover; border-radius: 20px; border: 5px solid #fff; box-shadow: 0 6px 18px rgba(20, 27, 45, 0.12); }
  .md :global(table) { width: 100%; border-collapse: collapse; font-size: 16px; line-height: 1.5; display: block; overflow-x: auto; }
  .md :global(th), .md :global(td) { border: 1px solid var(--line); padding: 10px 12px; text-align: start; vertical-align: top; }
  .md :global(th) { background: var(--cream); font-weight: 700; }
  .md :global(tr:nth-child(even) td) { background: #FAFAF7; }
  @media (max-width: 900px) {
    .md :global(img) { height: 240px; }
    .a-layout { grid-template-columns: 1fr; }
    .toc { position: static; }
    .prose img { height: 240px; }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) links.forEach((l) => l.classList.toggle('is-active', l.dataset.toc === e.target.id));
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  document.querySelectorAll('[data-sec], .md h2[id]').forEach((s) => io.observe(s));
</script>
