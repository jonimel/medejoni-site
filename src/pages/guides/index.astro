---
import Base from '../../layouts/Base.astro';
import { guides } from '../../data/guides';
import { img, thumb } from '../../data/site';
---
<Base title="מאמרים על טיול בקולומביה" description="מאמרים לטיול בקולומביה: מה עושים במדג'ין, טיול לגואטפה, טבע ליד העיר ועוד, מיונתן שגר במדג'ין." nav="guides">
  <section class="page-top">
    <div class="wrap" style="padding-top:40px;padding-bottom:40px">
      <nav class="crumbs" aria-label="פירורי לחם" style="padding-top:0"><a href="/">דף הבית</a> › מאמרים</nav>
      <h1 style="font-size:clamp(34px,5vw,52px);font-weight:800">מאמרים לפני שטסים</h1>
      <p style="font-size:19px;margin-top:10px;color:var(--text)">כל מה שכדאי לדעת לפני טיול בקולומביה, מישראלי שגר במדג'ין.</p>
    </div>
  </section>
  <section class="wrap section">
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:28px">
      {guides.map((g) => (
        <a href={`/guides/${g.slug}/`} class="card" style="text-decoration:none;color:inherit;border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column">
          <div style="height:220px;overflow:hidden"><img class="zoom" src={thumb(g.image)} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover" /></div>
          <div style="padding:18px 20px 22px;display:flex;flex-direction:column;gap:8px">
            <span class="pill pill-soft" style="align-self:flex-start">{g.tag}</span>
            <h2 style="font-size:21px;font-weight:600;line-height:1.4">{g.title}</h2>
            <span style="font-size:15px;color:var(--muted)">{g.sub}</span>
            <span style="font-size:15px;color:var(--link);font-weight:600">לקריאה ←</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
