---
import Base from '../../layouts/Base.astro';
import { guides } from '../../data/guides';
import { img, thumb } from '../../data/site';
---
<Base title="מאמרים על טיול בקולומביה" description="מאמרים לטיול בקולומביה: מה עושים במדג'ין, טיול לגואטפה, טבע ליד העיר ועוד, מאת יונתן מילמן." nav="guides">
  <section class="page-top">
    <div class="wrap" style="padding-top:40px;padding-bottom:40px">
      <nav class="crumbs" aria-label="פירורי לחם" style="padding-top:0"><a href="/">דף הבית</a> › מאמרים</nav>
      <h1 style="font-size:clamp(34px,5vw,52px);font-weight:800">מאמרים לפני שטסים</h1>
      <p style="font-size:19px;margin-top:10px;color:var(--text)">כל מה שכדאי לדעת לפני טיול בקולומביה.</p>
    </div>
  </section>
  <section class="wrap section">
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));gap:24px">
      {guides.map((g) => (
        <a href={`/guides/${g.slug}/`} class="post-card card">
          <div class="media"><img class="zoom" src={thumb(g.image)} alt="" loading="lazy" width="600" height="450" /></div>
          <div class="body">
            <span class="pill pill-soft" style="align-self:flex-start">{g.tag}</span>
            <h3>{g.title}</h3>
            <span class="sub">{g.sub}</span>
            <span class="more">לקריאה ←</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
