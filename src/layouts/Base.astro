---
import '@fontsource-variable/rubik/wght.css';
import '../styles/global.css';
// The font is served from our own site (no extra trip to Google); the Hebrew part is preloaded.
import rubikHebrew from '@fontsource-variable/rubik/files/rubik-hebrew-wght-normal.woff2?url';
import Icon from '../components/Icon.astro';
import PromoPopup from '../components/PromoPopup.astro';
import { site, waLink } from '../data/site';
import { tours } from '../data/tours';
import { guides } from '../data/guides';
import { services } from '../data/services';
import { toursEn } from '../data/tours.en';
import { servicesEn } from '../data/services.en';
import { ui, lp, translated, type Lang } from '../i18n';
import { imageSize } from '../lib/image-size.mjs';
import { join } from 'node:path';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  nav?: 'home' | 'tours' | 'destinations' | 'services' | 'guides' | 'about';
  waText?: string;
  noindex?: boolean;
  /** 'article' for blog posts, 'website' for everything else (Open Graph). */
  ogType?: 'website' | 'article';
  /** Short description of the share image (og:image:alt). */
  imageAlt?: string;
  /** Hide the floating WhatsApp button (booking page, or pages with their own sticky booking bar). */
  bodyClass?: string;
  /** Page language. Hebrew is the main site; English pages live under /en/. */
  lang?: Lang;
}
const { title, description, image = '/images/guatape-colombia-el-penol.jpg', jsonLd, nav, waText, noindex, ogType = 'website', imageAlt, bodyClass, lang = 'he' } = Astro.props;
const t = ui[lang];
const en = lang === 'en';
const fullTitle = title.includes(site.name) || title.includes("מדג'וני") ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogPath = image.replace(/\.webp$/, '.jpg');
const ogImage = new URL(ogPath, Astro.site);
const ogSize = imageSize(join(process.cwd(), 'public', ogPath));
const siteUrl = new URL('/', Astro.site).toString();
const wa = waLink(waText ?? t.waDefault);
// The same page in the other language (hreflang + the language link in the header).
const path = Astro.url.pathname;
const hasTwin = !noindex && translated(path);
const hePath = path.replace(/^\/en\//, '/');
const enPath = lp('en', hePath);
const heUrl = new URL(hePath, Astro.site);
const enUrl = new URL(enPath, Astro.site);
// The switch keeps the visitor on the same page (on booking, the script below also carries over the ?tour= choice); hreflang only on indexed pages.
const twinForSwitch = translated(path) || /^\/(en\/)?booking\/$/.test(path);
const switchHref = (en ? (twinForSwitch ? hePath : '/') : twinForSwitch ? enPath : '/en/');
// The English site has no destination or article pages (yet).
const navItems = [
  { key: 'home', href: '/' },
  { key: 'destinations', href: '/destinations/' },
  { key: 'tours', href: '/tours/' },
  { key: 'services', href: '/services/' },
  { key: 'guides', href: '/guides/' },
  { key: 'about', href: '/about/' },
]
  .filter((n) => !en || (n.key !== 'destinations' && n.key !== 'guides'))
  .map((n) => ({ ...n, href: lp(lang, n.href), label: t.nav[n.key as keyof typeof t.nav] }));
// The business, once per page. Other schema (tours, articles) points to it by @id.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': `${siteUrl}#org`,
  name: site.name,
  alternateName: 'מדג׳וני',
  slogan: site.tagline,
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).toString(), width: 512, height: 512 },
  image: new URL('/images/israeli-guide-medellin-yonatan.jpg', Astro.site).toString(),
  email: site.email,
  telephone: site.whatsapp ? `+${site.whatsapp}` : undefined,
  founder: { '@type': 'Person', '@id': `${siteUrl}#yonatan`, name: 'Yonatan Milman', alternateName: ui.he.owner, url: new URL('/about/', Astro.site).toString() },
  address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressRegion: 'Antioquia', addressCountry: 'CO' },
  areaServed: { '@type': 'Country', name: 'Colombia' },
  currenciesAccepted: 'COP',
  knowsLanguage: ['he', 'es', 'en'],
  sameAs: [site.instagram, site.tiktok, site.googleBusiness].filter((u) => !/\.com\/?$/.test(u)),
};
const footerTours = (en ? toursEn : tours).filter((x) => x.featured).slice(0, 4);
const footerServices = en ? servicesEn : services;
---
<!doctype html>
<html lang={lang} dir={t.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
  {!noindex && <link rel="alternate" hreflang="he" href={hasTwin ? heUrl : canonical} />}
  {hasTwin && <link rel="alternate" hreflang="en" href={enUrl} />}
  {!noindex && <link rel="alternate" hreflang="x-default" href={hasTwin ? heUrl : canonical} />}
  {site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}
  {site.bingVerification && <meta name="msvalidate.01" content={site.bingVerification} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content={t.locale} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
  {ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}
  <meta property="og:image:alt" content={imageAlt ?? fullTitle} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#FCD116" />
  <!-- Site icon: browser tab + Google search results (Google needs a square icon, a multiple of 48px). -->
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/icon-96.png" type="image/png" sizes="96x96" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preload" href={rubikHebrew} as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd ? [orgLd].concat(jsonLd as any) : orgLd)} />
  {site.gaId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
      <script is:inline define:vars={{ gaId: site.gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )}
</head>
<body class={bodyClass}>
  <a href="#main" class="sr-only skip-link">{t.skip}</a>
  <header class="site-header">
    <div class="wrap">
      <a href={lp(lang, '/')} class="logo">
        <img class="logo-img" src="/images/logo-112.webp" srcset="/images/logo-112.webp 1x, /images/logo-224.webp 2x" width="56" height="56" alt="" />
        <span class="logo-text">
          <span class="logo-name">Medejoni</span>
          <span class="logo-sub">{t.tagline}</span>
        </span>
        <span class="sr-only">{t.toHome}</span>
      </a>
      <nav class="main-nav" aria-label={t.mainNav}>
        {navItems.map((n) => <a href={n.href} aria-current={(nav ?? (Astro.url.pathname === lp(lang, '/') ? 'home' : undefined)) === n.key ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <a href={switchHref} class="lang-switch" lang={en ? 'he' : 'en'} hreflang={en ? 'he' : 'en'} aria-label={t.switchAria}>{t.switchLabel}</a>
      <button class="menu-btn" type="button" aria-label={t.openMenu} aria-expanded="false" aria-controls="mobile-nav" data-menu-btn><Icon name="menu" size={26} /></button>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label={t.mobileNav}>
      {[...navItems.filter((n) => n.key === 'home' || n.key === 'about'), ...navItems.filter((n) => n.key !== 'home' && n.key !== 'about')].map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="flag flag-thin" aria-hidden="true"><span></span><span></span><span></span></div>
  </header>

  <main id="main" tabindex="-1"><slot /></main>

  <footer class="site-footer">
    <div class="top">
      <div class="wrap cols">
        <details class="col" open data-foot-group>
          <summary><strong>{t.myTours}</strong></summary>
          <div class="col-links">
            {footerTours.map((x) => <a href={lp(lang, `/tours/${x.slug}/`)}>{x.title}</a>)}
            <a href={lp(lang, '/tours/')} style="color: var(--blue); font-weight: 600">{t.allToursArrow}</a>
          </div>
        </details>
        {!en && (
          <details class="col" open data-foot-group>
            <summary><strong>{t.articles}</strong></summary>
            <div class="col-links">
              {guides.slice(0, 4).map((g) => <a href={`/guides/${g.slug}/`}>{g.seoTitle ?? g.title}</a>)}
            </div>
          </details>
        )}
        <details class="col" open data-foot-group>
          <summary><strong>{t.servicesTitle}</strong></summary>
          <div class="col-links">
            {footerServices.map((x) => <a href={lp(lang, `/services/#${x.id}`)}>{x.title}</a>)}
          </div>
        </details>
        <details class="col" open data-foot-group>
          <summary><strong>{t.info}</strong></summary>
          <div class="col-links">
            <a href={lp(lang, '/about/')}>{t.nav.about}</a>
            <a href={lp(lang, '/tours/#faq')}>{t.faq}</a>
            {!en && <a href="/accessibility/">{t.accessibility}</a>}
            <a href={lp(lang, '/terms/')}>{t.terms}</a>
            <a href={lp(lang, '/privacy/')}>{t.privacy}</a>
            <span style="color:var(--muted)">{t.cancelNote}</span>
          </div>
        </details>
        <div class="col">
          <strong>{t.talkToMe}</strong>
          <span style="color: var(--muted); line-height: 1.6">{t.talkToMeSub}</span>
          <a href={wa} class="btn btn-yellow btn-pill" style="align-self: flex-start; color: var(--ink)" target="_blank" rel="noopener">{t.whatsapp}</a>
        </div>
      </div>
    </div>
    <div class="bottom">
      <div class="wrap">
        <img class="footer-logo" src="/images/logo-224.webp" width="96" height="96" alt={t.logoAlt} loading="lazy" decoding="async" />
        <span>© {new Date().getFullYear()} Medejoni · {t.owner}. {t.rights}<br /><span class="ltr" lang="es">{site.company.name} · NIT {site.company.nit} · {site.company.address}</span></span>
        <span class="social">
          <a href={site.instagram} aria-label={t.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={24} /></a>
          <a href={site.tiktok} aria-label={t.tiktok} target="_blank" rel="noopener"><Icon name="tiktok" size={24} /></a>
        </span>
      </div>
    </div>
    <a href={waLink(t.waQuestion)} class="wa-float" target="_blank" rel="noopener" aria-label={t.waFloat}><Icon name="whatsapp" size={28} /></a>
  </footer>
  {!en && <PromoPopup />}

  <script>
    // English pages (/en/) use English messages in these scripts.
    const EN = document.documentElement.lang === 'en';
    // Language switch on the booking page: keep the chosen tour and group size.
    const sw = document.querySelector<HTMLAnchorElement>('.lang-switch');
    if (sw && location.search && /\/booking\/$/.test(sw.pathname)) sw.search = location.search;
    // Mobile menu
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const menu = document.getElementById('mobile-nav');
    const setMenu = (open: boolean) => {
      menu?.classList.toggle('is-open', open);
      btn?.setAttribute('aria-expanded', String(open));
      btn?.setAttribute('aria-label', open ? (EN ? 'Close menu' : 'סגירת תפריט') : (EN ? 'Open menu' : 'פתיחת תפריט'));
    };
    btn?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
    // Escape closes the mobile menu and returns focus to its button.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu?.classList.contains('is-open')) { setMenu(false); btn?.focus(); }
    });
    // Skip link: move keyboard focus into the main content, not just scroll.
    document.querySelector('.skip-link')?.addEventListener('click', () => document.getElementById('main')?.focus());

    // Partner referrals: a link like https://medejoni.com/?utm_source=agal (or ?ref=agal) marks the visitor
    // as coming from that partner for 30 days (last partner link wins), so their lead email says so.
    // Visits themselves are counted by Google Analytics from the utm_source in the link.
    const REF_KEY = 'mj_partner';
    const REF_DAYS = 30;
    let partner = '';
    try {
      const q = new URLSearchParams(location.search);
      const fromUrl = (q.get('utm_source') || q.get('ref') || '').trim().toLowerCase();
      if (/^[a-z0-9_-]{1,40}$/.test(fromUrl)) {
        localStorage.setItem(REF_KEY, JSON.stringify({ code: fromUrl, until: Date.now() + REF_DAYS * 864e5 }));
        // Count the visit in Supabase (server: /api/visit). Only once the page is really shown to the visitor,
        // and not again on refresh (sessionStorage) or later pages (server cookie).
        const send = () => {
          try { if (sessionStorage.getItem('mj_visit_sent') === location.href) return; sessionStorage.setItem('mj_visit_sent', location.href); } catch { /* ignore */ }
          fetch('/api/visit', {
            method: 'POST', keepalive: true, credentials: 'same-origin',
            headers: { 'Content-Type': 'text/plain' },
            body: JSON.stringify({ code: fromUrl, page: location.pathname, referrer: document.referrer }),
          }).catch(() => {});
        };
        if ((document as any).prerendering) document.addEventListener('prerenderingchange', send, { once: true });
        else send();
      }
      const saved = JSON.parse(localStorage.getItem(REF_KEY) || 'null');
      if (saved && saved.until > Date.now()) partner = saved.code;
      else localStorage.removeItem(REF_KEY);
    } catch { /* storage blocked: just don't attribute */ }

    // WhatsApp clicks: saved by the server in Supabase (table whatsapp_clicks) and counted in Google Analytics.
    // sendBeacon does not delay opening WhatsApp, and a failure is ignored.
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest?.('a[href*="wa.me/"]');
      if (!a) return;
      (window as any).gtag?.('event', 'whatsapp_click', { page_path: location.pathname, partner: partner || undefined });
      try {
        navigator.sendBeacon?.('/api/wa-click', new Blob([JSON.stringify({ page: location.pathname, partner })], { type: 'text/plain' }));
      } catch { /* ignore */ }
    });

    // Message for a visitor who sent more than 3 forms in 30 minutes (the server answers 429), with a WhatsApp link.
    (window as any).mjTooMany = (el: HTMLElement) => {
      el.textContent = EN ? 'We already received your message 🙏 You can send again in half an hour, or ' : 'כבר קיבלנו את הפנייה שלכם 🙏 אפשר לשלוח שוב בעוד חצי שעה, או ';
      const a = document.createElement('a');
      a.href = document.querySelector<HTMLAnchorElement>('.wa-float')?.href || 'https://wa.me/';
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = EN ? 'message me on WhatsApp now' : 'לכתוב לי עכשיו בוואטסאפ';
      a.style.textDecoration = 'underline';
      el.append(a);
    };

    // Lead forms: post to the server (emailed to Jonathan) and show a thank-you message.
    document.querySelectorAll<HTMLFormElement>('form[data-lead]').forEach((form) => {
      const status = form.querySelector<HTMLElement>('[data-status]')!;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = EN ? 'Sending...' : 'שולח...';
        status.className = 'form-status full';
        status.textContent = '';
        try {
          const res = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: (() => {
              const data = new URLSearchParams(new FormData(form) as any);
              if (partner) data.set('partner', partner);
              return data.toString();
            })(),
          });
          if (res.status === 429) {
            // Spam guard: more than 3 sends in 30 minutes from this address.
            status.classList.add('err');
            (window as any).mjTooMany(status);
            return;
          }
          if (!res.ok) throw new Error(String(res.status));
          // Google Analytics: count the lead (only when analytics is on).
          (window as any).gtag?.('event', 'generate_lead', { form_name: form.getAttribute('name') || 'lead' });
          form.reset();
          status.classList.add('ok');
          status.textContent = EN ? 'Thank you! We got your details, and Yonatan will get back to you soon.' : 'תודה! קיבלנו את הפרטים, ויונתן יחזור אליכם בהקדם.';
        } catch {
          status.classList.add('err');
          status.textContent = EN ? 'Something went wrong. Please try again in a moment.' : 'משהו השתבש בשליחה. נסו שוב בעוד רגע.';
        } finally {
          btn.disabled = false;
          btn.textContent = label;
        }
      });
    });
    // Date fields can't be in the past.
    const today = new Date().toISOString().slice(0, 10);
    document.querySelectorAll<HTMLInputElement>('form[data-lead] input[type=date]').forEach((d) => (d.min = today));

    // Footer: on phones the link groups start closed (tap a title to open it); on larger screens they stay open.
    if (matchMedia('(max-width: 700px)').matches) document.querySelectorAll<HTMLDetailsElement>('[data-foot-group]').forEach((d) => (d.open = false));
    else document.querySelectorAll<HTMLElement>('[data-foot-group] > summary').forEach((s) => { s.tabIndex = -1; s.addEventListener('click', (e) => e.preventDefault()); });

    // Carousels: arrow buttons scroll the track by one card
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('.carousel-track')!;
      // A track with no links inside still needs to be reachable by keyboard so it can be scrolled.
      if (!track.querySelector('a, button, input, select, textarea, [tabindex]')) {
        track.tabIndex = 0;
        track.setAttribute('aria-label', root.getAttribute('aria-label') ?? '');
      }
      const prev = root.querySelector<HTMLButtonElement>('.carousel-btn.prev');
      const next = root.querySelector<HTMLButtonElement>('.carousel-btn.next');
      const step = () => {
        const first = track.firstElementChild as HTMLElement | null;
        return first ? first.getBoundingClientRect().width + 24 : 300;
      };
      // RTL: scrollLeft is 0 at start and negative going forward. LTR (English): positive going forward.
      const fwd = EN ? 1 : -1;
      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        const pos = Math.abs(track.scrollLeft);
        if (prev) prev.disabled = pos < 4;
        if (next) next.disabled = pos > max - 4;
      };
      prev?.addEventListener('click', () => track.scrollBy({ left: -fwd * step() }));
      next?.addEventListener('click', () => track.scrollBy({ left: fwd * step() }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();

      // Auto-advance (opt-in, larger screens only; on phones it's swipe only): every 4s, loops back to the start,
      // pauses while the visitor hovers, touches or focuses it, or when it is off screen.
      if (root.hasAttribute('data-auto') && matchMedia('(min-width: 901px)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let paused = false;
        let stopped = false;
        const pauseBtn = root.querySelector<HTMLButtonElement>('[data-carousel-pause]');
        if (pauseBtn) {
          pauseBtn.hidden = false;
          pauseBtn.addEventListener('click', () => {
            stopped = !stopped;
            pauseBtn.setAttribute('aria-pressed', String(stopped));
            pauseBtn.setAttribute('aria-label', stopped ? (EN ? 'Resume scrolling' : 'הפעלת גלילה') : (EN ? 'Pause scrolling' : 'עצירת גלילה'));
          });
        }
        let visible = false;
        let resumeAt = 0;
        const hold = (ms: number) => { resumeAt = Date.now() + ms; };
        root.addEventListener('mouseenter', () => (paused = true));
        root.addEventListener('mouseleave', () => (paused = false));
        root.addEventListener('focusin', () => (paused = true));
        root.addEventListener('focusout', () => (paused = false));
        track.addEventListener('touchstart', () => hold(8000), { passive: true });
        prev?.addEventListener('click', () => hold(8000));
        next?.addEventListener('click', () => hold(8000));
        new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.4 }).observe(root);
        setInterval(() => {
          if (stopped || paused || !visible || document.hidden || Date.now() < resumeAt) return;
          const max = track.scrollWidth - track.clientWidth;
          if (max < 4) return;
          if (Math.abs(track.scrollLeft) >= max - 4) track.scrollTo({ left: 0 });
          else track.scrollBy({ left: fwd * step() });
        }, 4000);
      }
    });
  </script>
</body>
</html>
