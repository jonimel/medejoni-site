---
import { type Tour, kindLabel, fromPrice, hasTiers } from '../data/tours';
import { formatCOP, img, thumb } from '../data/site';
interface Props { tour: Tour; lazy?: boolean }
const { tour, lazy = true } = Astro.props;
const price = fromPrice(tour);
---
<a href={`/tours/${tour.slug}/`} class="tour-card card" data-kind={tour.kind} data-couples={tour.couples ? '' : undefined} data-dest={tour.destination} data-price={price} data-title={tour.title}>
  <div class="media">
    <img class="zoom" src={thumb(tour.images[0])} alt={tour.title} loading={lazy ? 'lazy' : 'eager'} width="600" height="420" />
    <span class="pill">{kindLabel[tour.kind]}</span>
    {tour.recommended && <span class="pill pill-reco reco">★ מומלץ</span>}
    {!tour.recommended && tour.badge && <span class="pill pill-dark reco">{tour.badge}</span>}
  </div>
  <div class="body">
    <span class="place">{tour.place}, קולומביה</span>
    <h3>{tour.title}</h3>
    <span class="desc">{tour.short}</span>
    <div class="tags">{tour.tags.map((t) => <span class="tag">{t}</span>)}</div>
    <div class="foot">
      <span class="price-line">{hasTiers(tour) ? 'החל מ־' : ''}<span class="ltr">{formatCOP(price)}</span><small>/ לאדם</small></span>
    </div>
  </div>
</a>

<style>
  .media .pill.reco { right: auto; left: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.18); }
</style>
