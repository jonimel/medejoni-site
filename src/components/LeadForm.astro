---
// "Leave your details" form. Submissions go to Netlify Forms (form name "lead"),
// which emails each lead. Submit handling lives in Base.astro.
interface Props { title?: string; sub?: string; source: string }
const { title = 'השאירו פרטים, ויונתן יחזור אליכם', sub = 'שאלה על טיול, הסעה או טיסה? תשובה בעברית, בדרך כלל באותו יום.', source } = Astro.props;
const options = ['טיול', 'הסעה משדה התעופה', 'מעבר בין ערים', 'סגירת טיסות', 'תכנון טיול שלם', 'אחר'];
---
<section class="lead-wrap" id="contact">
  <div class="wrap lead">
    <div class="lead-text">
      <h2>{title}</h2>
      <p>{sub}</p>
    </div>
    <form name="lead" method="POST" data-netlify="true" netlify-honeypot="company" class="form-card" data-lead>
      <input type="hidden" name="form-name" value="lead" />
      <input type="hidden" name="source" value={source} />
      <p hidden><label>Company <input name="company" /></label></p>
      <label>שם מלא<input name="name" required autocomplete="name" /></label>
      <label>טלפון<input name="phone" type="tel" required autocomplete="tel" dir="ltr" /></label>
      <label>במה אפשר לעזור?
        <select name="interest">{options.map((o) => <option>{o}</option>)}</select>
      </label>
      <label>מתי אתם בקולומביה?<input name="dates" placeholder="למשל: 10–20 בדצמבר" /></label>
      <label class="full">הודעה<textarea name="message" rows="3"></textarea></label>
      <button type="submit" class="btn btn-dark full">שליחה</button>
      <p class="form-status full" role="status" data-status></p>
    </form>
  </div>
</section>

<style>
  .lead-wrap { background: var(--yellow); }
  .lead { padding-top: 64px; padding-bottom: 64px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 48px; align-items: center; }
  .lead-text h2 { font-size: clamp(28px, 4vw, 38px); font-weight: 800; margin-bottom: 12px; }
  .lead-text p { font-size: 18px; line-height: 1.6; }
  .lead .form-card { border: 0; }
  @media (max-width: 900px) {
    .lead { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
</style>
