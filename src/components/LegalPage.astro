---
// Shared layout for the legal pages (/terms/, /privacy/): Hebrew first, then the same text in Spanish
// (for Colombian authorities and the payment company Bold, which reviews the site).
import Base from '../layouts/Base.astro';
interface Props { title: string; description: string; crumb: string; intro: string }
const { title, description, crumb, intro } = Astro.props;
---
<Base title={title} description={description}>
  <section class="page-top">
    <div class="wrap" style="padding-top:40px;padding-bottom:40px">
      <nav class="crumbs" aria-label="פירורי לחם" style="padding-top:0;color:var(--ink)"><a href="/" style="color:var(--ink)">דף הבית</a> › {crumb}</nav>
      <h1 style="font-size:clamp(32px,5vw,50px);font-weight:800">{title}</h1>
      <p style="font-size:19px;margin-top:10px">{intro}</p>
      <p style="margin-top:8px"><a href="#es" lang="es" style="color:var(--ink);text-decoration:underline">Versión en español</a></p>
    </div>
  </section>
  <article class="wrap section legal">
    <slot />
    <section id="es" lang="es" dir="ltr" class="legal-es">
      <slot name="es" />
    </section>
  </article>
</Base>

<style>
  .legal { max-width: 860px; }
  .legal :global(h2) { font-size: 25px; font-weight: 700; margin: 34px 0 12px; }
  .legal :global(h2:first-child) { margin-top: 0; }
  .legal :global(p), .legal :global(li) { font-size: 17px; line-height: 1.75; color: var(--text); }
  .legal :global(p + p) { margin-top: 10px; }
  .legal :global(ul) { padding-inline-start: 22px; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .legal :global(.legal-box) { margin: 18px 0; padding: 18px 22px; background: var(--cream); border-radius: 16px; }
  .legal-es { margin-top: 56px; padding-top: 32px; border-top: 2px dashed var(--line); text-align: left; }
  .legal :global(.updated) { margin-top: 32px; color: var(--muted); font-size: 15px; }
</style>
